@page "/carrito"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Globalization
@using System.Security.Claims
@using Usaditos2026.Servicios.Interfaces
@using Usaditos2026.Shared.Constantes
@using Usaditos2026.Shared.DTOs
@using Usaditos2026.Shared.Excepciones
@inject ICarritoServicio CarritoServicio
@inject NavigationManager Navigation

<PageTitle>Carrito</PageTitle>

<h1 class="carrito-titulo mb-4">Carrito</h1>

@if (!string.IsNullOrWhiteSpace(_mensajeError))
{
    <div class="alert @_claseMensajeError carrito-alert mb-4" role="alert">@_mensajeError</div>
}

@if (_cargando)
{
    <p class="carrito-estado">Cargando carrito...</p>
}
else if (_carrito is null || _carrito.Items.Count == 0)
{
    <div class="card card-vacio text-center py-5">
        <div class="card-body d-flex flex-column align-items-center">
            <div class="icono-vacio mb-3" aria-hidden="true">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    <line x1="3" y1="3" x2="21" y2="21"></line>
                </svg>
            </div>
            <p class="texto-vacio mb-3">Tu carrito está vacío</p>
            <a class="btn btn-primary btn-volver px-4" href="/catalogo">Volver al catálogo</a>
        </div>
    </div>
}
else
{
    <div class="row row-cols-1 g-3">
        @foreach (var item in _carrito.Items)
        {
            <div class="col">
                <div class="card card-item h-100">
                    <div class="card-body d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                        <div class="item-info">
                            <h5 class="card-title item-nombre text-break mb-1">@item.NombreProducto</h5>
                            <p class="item-precio-unitario mb-0">
                                <strong>Precio unitario: </strong>
                                @item.PrecioUnitario.ToString("C", new CultureInfo("es-AR"))
                            </p>
                        </div>

                        <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between justify-content-md-end gap-3 flex-wrap">
                            <div class="d-flex align-items-center gap-2 controles-cantidad">
                                <button type="button" class="btn btn-outline-secondary btn-sm btn-cantidad"
                                        aria-label="Disminuir cantidad de @item.NombreProducto"
                                        disabled="@(item.Cantidad <= 1 || _procesando)"
                                        @onclick="() => ModificarCantidadAsync(item.Id, item.Cantidad - 1)">
                                    −
                                </button>
                                <span class="fw-bold cantidad">@item.Cantidad</span>
                                <button type="button" class="btn btn-outline-secondary btn-sm btn-cantidad"
                                        aria-label="Aumentar cantidad de @item.NombreProducto"
                                        disabled="@(item.Cantidad >= CarritoConstantes.LimiteUnidadesPorProducto || _procesando)"
                                        @onclick="() => ModificarCantidadAsync(item.Id, item.Cantidad + 1)">
                                    +
                                </button>
                            </div>

                            <div class="item-subtotal-block">
                                <span class="subtotal-label">Subtotal:</span>
                                <span class="subtotal-valor">@item.Subtotal.ToString("C", new CultureInfo("es-AR"))</span>
                            </div>

                            <button type="button" class="btn btn-outline-danger btn-sm btn-eliminar"
                                    aria-label="Eliminar @item.NombreProducto del carrito"
                                    disabled="@_procesando"
                                    @onclick="() => EliminarAsync(item.Id)">
                                Eliminar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card card-resumen mt-4">
        <div class="card-body d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
            <div class="total-block">
                <span class="total-label">Total:</span>
                <span class="total-monto">@_carrito.Total.ToString("C", new CultureInfo("es-AR"))</span>
            </div>
            <button type="button" class="btn btn-outline-danger btn-vaciar" disabled="@_procesando" @onclick="VaciarAsync">
                Vaciar carrito
            </button>
        </div>
    </div>
}

@code {
    private CarritoDto? _carrito;
    private int? _clienteId;
    private bool _cargando = true;
    private bool _procesando;
    private string? _mensajeError;
    private string _claseMensajeError = "alert-warning";

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is null)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        var authenticationState = await AuthenticationStateTask;
        var idClaim = authenticationState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!int.TryParse(idClaim, out var clienteId))
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        _clienteId = clienteId;

        try
        {
            _carrito = await CarritoServicio.ObtenerCarritoAsync(clienteId);
        }
        catch (Exception)
        {
            _mensajeError = "No se pudo cargar el carrito. Intentá de nuevo.";
            _claseMensajeError = "alert-danger";
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task ModificarCantidadAsync(int itemId, int nuevaCantidad)
    {
        if (_clienteId is null)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        _mensajeError = null;
        _claseMensajeError = "alert-warning";
        _procesando = true;

        try
        {
            _carrito = await CarritoServicio.ModificarCantidadAsync(_clienteId.Value, itemId, nuevaCantidad);
        }
        catch (StockInsuficienteException ex)
        {
            _mensajeError = ex.Message;
        }
        catch (LimiteUnidadesException ex)
        {
            _mensajeError = ex.Message;
        }
        catch (Exception)
        {
            _mensajeError = "No se pudo actualizar el carrito. Intentá de nuevo.";
            _claseMensajeError = "alert-danger";
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task EliminarAsync(int itemId)
    {
        if (_clienteId is null)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        _mensajeError = null;
        _claseMensajeError = "alert-warning";
        _procesando = true;

        try
        {
            _carrito = await CarritoServicio.EliminarProductoAsync(_clienteId.Value, itemId);
        }
        catch (StockInsuficienteException ex)
        {
            _mensajeError = ex.Message;
        }
        catch (LimiteUnidadesException ex)
        {
            _mensajeError = ex.Message;
        }
        catch (Exception)
        {
            _mensajeError = "No se pudo actualizar el carrito. Intentá de nuevo.";
            _claseMensajeError = "alert-danger";
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task VaciarAsync()
    {
        if (_clienteId is null)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        _mensajeError = null;
        _claseMensajeError = "alert-warning";
        _procesando = true;

        try
        {
            _carrito = await CarritoServicio.VaciarCarritoAsync(_clienteId.Value);
        }
        catch (StockInsuficienteException ex)
        {
            _mensajeError = ex.Message;
        }
        catch (LimiteUnidadesException ex)
        {
            _mensajeError = ex.Message;
        }
        catch (Exception)
        {
            _mensajeError = "No se pudo actualizar el carrito. Intentá de nuevo.";
            _claseMensajeError = "alert-danger";
        }
        finally
        {
            _procesando = false;
        }
    }
}
