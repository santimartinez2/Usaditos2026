@page "/Error"
@using System.Diagnostics
@inject IHostEnvironment Environment

<PageTitle>Algo salió mal – Usaditos Hernando</PageTitle>

<div class="container py-5 d-flex justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="card error-boundary-card p-4 p-md-5 text-center mx-auto" style="max-width: 580px; width: 100%;">
        <div class="error-boundary-icon-wrapper mb-3 mx-auto" aria-hidden="true">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#C8453A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
        </div>

        <h1 class="error-boundary-title mb-2">Algo salió mal</h1>
        <p class="error-boundary-text mb-4">
            Ocurrió un problema inesperado al procesar tu solicitud. Ya registramos lo sucedido para resolverlo cuanto antes.
        </p>

        @if (ShowRequestId)
        {
            <div class="alert alert-light border mb-4 py-2 px-3 d-inline-block mx-auto text-start" style="font-size: 0.875rem; background-color: #FAF8F2; border-color: #E8E2CF !important;">
                <span class="text-muted">Identificador de seguimiento:</span>
                <code class="text-dark fw-bold ms-1">@RequestId</code>
            </div>
        }

        @if (Environment.IsDevelopment())
        {
            <div class="alert alert-warning text-start mb-4" style="font-size: 0.85rem; border-radius: 10px;">
                <strong>Modo Desarrollo:</strong> El entorno actual es <code>Development</code>. Revisá los registros de la consola para ver los detalles y el stack trace de la excepción.
            </div>
        }

        <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
            <a href="/catalogo" class="btn btn-primary px-4">
                Volver al catálogo
            </a>
            <a href="." class="btn btn-outline-primary px-4">
                Recargar página
            </a>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
