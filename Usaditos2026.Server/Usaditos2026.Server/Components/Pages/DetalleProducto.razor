@page "/producto/{id:int}"
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using Usaditos2026.Servicios.Interfaces
@using Usaditos2026.Shared.DTOs
@using Usaditos2026.Shared.Excepciones
@using Usaditos2026.Shared.Utilidades
@inject ICatalogoServicio CatalogoServicio
@inject ICarritoServicio CarritoServicio
@inject NavigationManager Navigation

<PageTitle>@(_producto is not null ? $"{_producto.Nombre} | Usaditos Hernando" : "Detalle de prenda | Usaditos Hernando")</PageTitle>

<div class="detalle-producto-container">
    <!-- Avisos de acción -->
    @if (!string.IsNullOrWhiteSpace(_mensajeExito))
    {
        <div class="alert alert-success detalle-alert alert-dismissible fade show d-flex align-items-center justify-content-between mb-4 shadow-sm" role="alert">
            <div class="d-flex align-items-center gap-2">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>@_mensajeExito</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a class="btn btn-sm btn-outline-success" href="/carrito">Ver carrito</a>
                <button type="button" class="btn-close" aria-label="Cerrar aviso" @onclick="() => _mensajeExito = null"></button>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_mensajeError))
    {
        <div class="alert @_claseMensajeError detalle-alert alert-dismissible fade show d-flex align-items-center justify-content-between mb-4 shadow-sm" role="alert">
            <div class="d-flex align-items-center gap-2">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>@_mensajeError</span>
            </div>
            <button type="button" class="btn-close" aria-label="Cerrar aviso" @onclick="() => _mensajeError = null"></button>
        </div>
    }

    @if (_cargando)
    {
        <div class="detalle-loading text-center py-5" role="status" aria-live="polite">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando prenda...</span>
            </div>
            <p class="mt-3 text-muted">Buscando prenda en el catálogo...</p>
        </div>
    }
    else if (_noEncontrado || _producto is null)
    {
        <!-- Estado: Prenda no encontrada -->
        <div class="prenda-no-encontrada text-center py-5" role="status">
            <div class="no-encontrado-icon-circle mx-auto mb-4" aria-hidden="true">
                <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
            </div>
            <h1 class="no-encontrado-titulo font-serif mb-3">Prenda no encontrada</h1>
            <p class="no-encontrado-desc mx-auto mb-4">
                La prenda que estás buscando no existe, fue pausada o ya no se encuentra disponible en nuestro catálogo.
            </p>
            <a href="/catalogo" class="btn btn-primary px-4 py-2">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2" aria-hidden="true">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
                <span>Volver al catálogo</span>
            </a>
        </div>
    }
    else
    {
        <!-- Migas de pan (Breadcrumbs) -->
        <nav aria-label="Migas de pan" class="detalle-breadcrumb-nav mb-4">
            <ol class="breadcrumb m-0">
                <li class="breadcrumb-item">
                    <a href="/catalogo" class="breadcrumb-link">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1" aria-hidden="true">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                        <span>Catálogo</span>
                    </a>
                </li>
                @if (!string.IsNullOrWhiteSpace(_producto.NombreCategoria))
                {
                    <li class="breadcrumb-item">
                        <a href="@($"/catalogo?categoriaId={_producto.CategoriaId}")" class="breadcrumb-link">
                            @_producto.NombreCategoria
                        </a>
                    </li>
                }
                <li class="breadcrumb-item active text-truncate" aria-current="page" style="max-width: 380px;">
                    @_producto.Nombre
                </li>
            </ol>
        </nav>

        <!-- Contenido Principal: Dos columnas en Desktop; Foto arriba e Info abajo en celular -->
        <div class="row g-4 g-lg-5 align-items-start mb-5">
            <!-- Columna Izquierda: Foto grande vertical con esquinas redondeadas -->
            <div class="col-12 col-lg-6">
                <div class="detalle-foto-card @(_producto.StockDisponible == 0 ? "foto-sin-stock" : "")">
                    @if (!string.IsNullOrWhiteSpace(_producto.ImagenUrl))
                    {
                        <img src="@_producto.ImagenUrl"
                             alt="@_producto.Nombre"
                             class="detalle-foto-img" />
                    }
                    else
                    {
                        <div class="detalle-foto-placeholder d-flex flex-column align-items-center justify-content-center" aria-hidden="true">
                            <svg class="placeholder-icon" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 3a2 2 0 0 1 2 2c0 1.1-.9 2-2 2a2 2 0 0 1-2-2 2 2 0 0 1 2-2z" />
                                <path d="M12 7v2" />
                                <path d="M2.5 16.5 12 9l9.5 7.5a1.5 1.5 0 0 1-.9 2.5H3.4a1.5 1.5 0 0 1-.9-2.5z" />
                            </svg>
                            <span class="placeholder-sub mt-2">Usaditos Hernando</span>
                        </div>
                    }

                    <!-- Badge Pieza única si Stock == 1 -->
                    @if (_producto.StockDisponible == 1)
                    {
                        <div class="foto-badge-unica" aria-hidden="true">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                            </svg>
                            <span>Pieza única</span>
                        </div>
                    }

                    <!-- Micro badge de foto real -->
                    <div class="foto-badge-verificacion" aria-hidden="true">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            <polyline points="9 12 11 14 15 10"></polyline>
                        </svg>
                        <span>Foto real de la prenda</span>
                    </div>

                    <!-- Overlay Vendido si Stock == 0 -->
                    @if (_producto.StockDisponible == 0)
                    {
                        <div class="foto-overlay-vendido" aria-hidden="true">
                            <span class="badge-vendido-overlay">Vendido</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Columna Derecha: Información detallada de la prenda -->
            <div class="col-12 col-lg-6">
                <div class="detalle-info-panel d-flex flex-column gap-3">
                    <!-- Categoría en texto chico -->
                    @if (!string.IsNullOrWhiteSpace(_producto.NombreCategoria))
                    {
                        <span class="producto-categoria-top">@_producto.NombreCategoria</span>
                    }

                    <!-- Nombre en serif grande (Fraunces) -->
                    <h1 class="producto-nombre-principal font-serif">@_producto.Nombre</h1>

                    <!-- Precio destacado ($ 4.500,00) -->
                    <div class="producto-precio-seccion d-flex align-items-baseline gap-2">
                        <span class="producto-precio-grande font-serif @(_producto.StockDisponible == 0 ? "precio-tachado" : "")">
                            @FormatearPrecio(_producto.Precio)
                        </span>
                        <span class="producto-precio-moneda">Precio final</span>
                    </div>

                    <!-- Chips bien visibles para Talle, Estado e Indicador de stock -->
                    <div class="producto-chips-contenedor d-flex flex-wrap align-items-center gap-2">
                        @if (!string.IsNullOrWhiteSpace(_producto.Talle))
                        {
                            <div class="detalle-chip chip-talle-destacado" title="Talle de la prenda">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M21.3 8.7 8.7 21.3c-1 1-2.5 1-3.4 0l-2.6-2.6c-1-1-1-2.5 0-3.4L15.3 2.7c1-1 2.5-1 3.4 0l2.6 2.6c1 1 1 2.5 0 3.4Z"></path>
                                    <path d="m7.5 10.5 2 2"></path>
                                    <path d="m10.5 7.5 2 2"></path>
                                    <path d="m13.5 4.5 2 2"></path>
                                </svg>
                                <span>@TalleTextoHelper.Formatear(_producto.Talle)</span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(_producto.EstadoTexto))
                        {
                            <div class="detalle-chip chip-estado-destacado" title="Estado de conservación">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                </svg>
                                <span>@_producto.EstadoTexto</span>
                            </div>
                        }

                        @if (_producto.StockDisponible == 1)
                        {
                            <div class="detalle-chip chip-stock-unica" title="Prenda exclusiva sin reposición">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                </svg>
                                <span>Pieza única</span>
                            </div>
                        }
                        else if (_producto.StockDisponible > 1)
                        {
                            <div class="detalle-chip chip-stock-escaso" title="Unidades disponibles">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="8" x2="12" y2="12"></line>
                                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                </svg>
                                <span>Quedan @_producto.StockDisponible</span>
                            </div>
                        }
                        else
                        {
                            <div class="detalle-chip chip-stock-agotado" title="Sin stock disponible">
                                <span>Sin stock</span>
                            </div>
                        }
                    </div>

                    <!-- Si el producto tiene Observaciones no vacías, mostrá una caja en amarillo suave (#FFD23F suave) con título "Detalle de la prenda" y el texto de Observaciones -->
                    @if (!string.IsNullOrWhiteSpace(_producto.Observaciones))
                    {
                        <div class="caja-observaciones">
                            <div class="caja-observaciones-titulo">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="11" cy="11" r="8"></circle>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                    <line x1="8" y1="11" x2="14" y2="11"></line>
                                </svg>
                                <span>Detalle de la prenda</span>
                            </div>
                            <p class="caja-observaciones-texto">@_producto.Observaciones</p>
                        </div>
                    }

                    <!-- Descripción de la prenda -->
                    @if (!string.IsNullOrWhiteSpace(_producto.Descripcion))
                    {
                        <div class="producto-descripcion-box">
                            <p class="producto-descripcion-parrafo">@_producto.Descripcion</p>
                        </div>
                    }

                    <!-- Acciones de compra -->
                    <div class="producto-acciones-compra pt-2">
                        @if (_producto.StockDisponible > 0)
                        {
                            <div class="acciones-fila d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-3">
                                @if (_producto.StockDisponible > 1)
                                {
                                    <div class="selector-cantidad-box">
                                        <span class="selector-cantidad-label">Cantidad</span>
                                        <div class="selector-cantidad-botones">
                                            <button type="button"
                                                    class="btn-cantidad-control"
                                                    @onclick="DisminuirCantidad"
                                                    disabled="@(_cantidad <= 1 || _agregando)"
                                                    aria-label="Disminuir cantidad">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                                </svg>
                                            </button>
                                            <span class="cantidad-numero" aria-live="polite">@_cantidad</span>
                                            <button type="button"
                                                    class="btn-cantidad-control"
                                                    @onclick="AumentarCantidad"
                                                    disabled="@(_cantidad >= _producto.StockDisponible || _agregando)"
                                                    aria-label="Aumentar cantidad">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                                </svg>
                                            </button>
                                        </div>
                                    </div>
                                }

                                <button type="button"
                                        class="btn btn-primary btn-agregar-grande flex-grow-1"
                                        @onclick="() => AgregarAlCarritoAsync()"
                                        disabled="@_agregando"
                                        aria-label="@($"Agregar {_producto.Nombre} al carrito")">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <circle cx="9" cy="21" r="1"></circle>
                                        <circle cx="20" cy="21" r="1"></circle>
                                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                    </svg>
                                    <span>@(_agregando ? "Agregando..." : "Agregar al carrito")</span>
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="sin-stock-acciones-wrap d-flex flex-column gap-3">
                                <button type="button" class="btn btn-secondary btn-vendido-grande w-100" disabled aria-disabled="true">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                                    </svg>
                                    <span>Vendido</span>
                                </button>

                                <a href="@($"/catalogo?categoriaId={_producto.CategoriaId}")" class="btn-prendas-similares">
                                    <span>Ver prendas similares</span>
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                        <polyline points="12 5 19 12 12 19"></polyline>
                                    </svg>
                                </a>
                            </div>
                        }
                    </div>

                    <!-- Las tres líneas con icono debajo del botón -->
                    <div class="detalle-trust-strip d-flex flex-column gap-2 pt-3">
                        <div class="trust-strip-item d-flex align-items-center gap-3">
                            <div class="trust-strip-icon icon-tienda" aria-hidden="true">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                </svg>
                            </div>
                            <span class="trust-strip-texto">Retirás en el local</span>
                        </div>

                        <div class="trust-strip-item d-flex align-items-center gap-3">
                            <div class="trust-strip-icon icon-pago" aria-hidden="true">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                                    <line x1="2" y1="10" x2="22" y2="10"></line>
                                </svg>
                            </div>
                            <span class="trust-strip-texto">Pagás en efectivo o transferencia</span>
                        </div>

                        <div class="trust-strip-item d-flex align-items-center gap-3">
                            <div class="trust-strip-icon icon-calidad" aria-hidden="true">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                    <polyline points="9 12 11 14 15 10"></polyline>
                                </svg>
                            </div>
                            <span class="trust-strip-texto">Prenda revisada una por una</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Sección inferior: Prendas relacionadas -->
        @if (_relacionados.Count > 0)
        {
            <section class="relacionados-seccion mt-5 pt-4 border-top" aria-label="Prendas que te pueden gustar">
                <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-2 mb-4">
                    <div>
                        <span class="relacionados-subtitulo text-uppercase">Sugerencias para vos</span>
                        <h2 class="relacionados-titulo font-serif">Más prendas que te pueden gustar</h2>
                    </div>
                    <a href="@($"/catalogo?categoriaId={_producto.CategoriaId}")" class="link-ver-catalogo">
                        <span>Ver más en @_producto.NombreCategoria</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </a>
                </div>

                <div class="grilla-productos-relacionados">
                    @foreach (var rel in _relacionados.Take(4))
                    {
                        var relSinStock = rel.StockDisponible == 0;
                        <article class="card-producto @(relSinStock ? "producto-sin-stock" : "")">
                            <a href="@($"/producto/{rel.Id}")" class="card-img-link" aria-label="@($"Ver detalle de {rel.Nombre}")">
                                <div class="card-img-container">
                                    @if (!string.IsNullOrWhiteSpace(rel.ImagenUrl))
                                    {
                                        <img src="@rel.ImagenUrl"
                                             alt="@rel.Nombre"
                                             class="card-img-top card-producto-img"
                                             loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="card-img-placeholder d-flex align-items-center justify-content-center" aria-hidden="true">
                                            <svg class="placeholder-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M12 3a2 2 0 0 1 2 2c0 1.1-.9 2-2 2a2 2 0 0 1-2-2 2 2 0 0 1 2-2z" />
                                                <path d="M12 7v2" />
                                                <path d="M2.5 16.5 12 9l9.5 7.5a1.5 1.5 0 0 1-.9 2.5H3.4a1.5 1.5 0 0 1-.9-2.5z" />
                                            </svg>
                                        </div>
                                    }

                                    <div class="card-chips-overlay">
                                        @if (!string.IsNullOrWhiteSpace(rel.Talle))
                                        {
                                            <span class="chip-badge chip-talle">@TalleTextoHelper.Formatear(rel.Talle)</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(rel.EstadoTexto))
                                        {
                                            <span class="chip-badge chip-estado">@rel.EstadoTexto</span>
                                        }
                                        @if (rel.StockDisponible == 1)
                                        {
                                            <span class="chip-badge chip-stock-unica">Pieza única</span>
                                        }
                                    </div>

                                    @if (relSinStock)
                                    {
                                        <div class="overlay-vendido" aria-hidden="true">
                                            <span class="badge-vendido">Vendido</span>
                                        </div>
                                    }
                                </div>
                            </a>

                            <div class="card-body d-flex flex-column justify-content-between">
                                <div class="card-info-top">
                                    @if (!string.IsNullOrWhiteSpace(rel.NombreCategoria))
                                    {
                                        <span class="producto-categoria">@rel.NombreCategoria</span>
                                    }
                                    <h3 class="producto-nombre">
                                        <a href="@($"/producto/{rel.Id}")" class="producto-nombre-link">@rel.Nombre</a>
                                    </h3>
                                </div>

                                <div class="card-action-bottom">
                                    <div class="producto-precio-wrap">
                                        <span class="producto-precio @(relSinStock ? "precio-agotado" : "")">
                                            @FormatearPrecio(rel.Precio)
                                        </span>
                                    </div>

                                    @if (relSinStock)
                                    {
                                        <button type="button" class="btn btn-vendido w-100" disabled aria-disabled="true">
                                            <span>Vendido</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <a href="@($"/producto/{rel.Id}")" class="btn btn-outline-primary w-100 btn-sm py-2">
                                            Ver detalle
                                        </a>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    }

    <!-- Toast flotante de microinteracción al agregar al carrito -->
    @if (_mostrarToast)
    {
        <div class="cart-toast" role="status" aria-live="polite">
            <div class="toast-icon-circle" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            <div class="toast-text-wrap">
                <span class="toast-headline">¡Prenda agregada!</span>
                <span class="toast-detail">@_toastMensaje</span>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private ProductoDto? _producto;
    private List<ProductoDto> _relacionados = new();
    private bool _cargando = true;
    private bool _noEncontrado = false;
    private int _cantidad = 1;
    private int? _clienteId;
    private bool _agregando = false;

    private string? _mensajeExito;
    private string? _mensajeError;
    private string _claseMensajeError = "alert-warning";
    private bool _mostrarToast = false;
    private string? _toastMensaje;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var authState = await AuthenticationStateTask;
            var idClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (int.TryParse(idClaim, out var clienteId))
            {
                _clienteId = clienteId;
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await CargarProductoAsync();
    }

    private async Task CargarProductoAsync()
    {
        _cargando = true;
        _noEncontrado = false;
        _mensajeExito = null;
        _mensajeError = null;
        _cantidad = 1;

        try
        {
            _producto = await CatalogoServicio.ObtenerProductoAsync(Id);

            try
            {
                _relacionados = await CatalogoServicio.ObtenerRelacionadosAsync(Id, 4);
            }
            catch
            {
                _relacionados = new List<ProductoDto>();
            }
        }
        catch (KeyNotFoundException)
        {
            _noEncontrado = true;
            _producto = null;
            _relacionados.Clear();
        }
        catch (Exception)
        {
            _noEncontrado = true;
            _producto = null;
            _relacionados.Clear();
        }
        finally
        {
            _cargando = false;
        }
    }

    private void DisminuirCantidad()
    {
        if (_cantidad > 1)
        {
            _cantidad--;
        }
    }

    private void AumentarCantidad()
    {
        if (_producto is not null && _cantidad < _producto.StockDisponible)
        {
            _cantidad++;
        }
    }

    private async Task AgregarAlCarritoAsync()
    {
        if (_producto is null)
            return;

        if (_clienteId is null)
        {
            Navigation.NavigateTo($"/login?returnUrl=/producto/{_producto.Id}", forceLoad: true);
            return;
        }

        _agregando = true;
        _mensajeExito = null;
        _mensajeError = null;

        try
        {
            var cantidadAAgregar = _cantidad > 0 ? _cantidad : 1;

            var carritoActualizado = await CarritoServicio.AgregarProductoAsync(
                _clienteId.Value,
                new AgregarItemCarritoRequest
                {
                    ProductoId = _producto.Id,
                    Cantidad = cantidadAAgregar
                });

            var unidades = carritoActualizado.Items.Sum(i => i.Cantidad);
            var total = FormatearPrecio(carritoActualizado.Total);
            _mensajeExito = $"Agregaste '{_producto.Nombre}' al carrito. Tu carrito: {unidades} unidad(es), total {total}.";

            _toastMensaje = $"Sumamos '{_producto.Nombre}' a tu carrito.";
            _mostrarToast = true;

            _ = Task.Delay(3500).ContinueWith(_ =>
            {
                _mostrarToast = false;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (StockInsuficienteException ex)
        {
            _mensajeError = ex.Message;
            _claseMensajeError = "alert-warning";
        }
        catch (Exception)
        {
            _mensajeError = "No se pudo agregar el producto. Intentá de nuevo.";
            _claseMensajeError = "alert-danger";
        }
        finally
        {
            _agregando = false;
        }
    }

    private static string FormatearPrecio(decimal precio)
    {
        var nfi = (NumberFormatInfo)CultureInfo.GetCultureInfo("es-AR").NumberFormat.Clone();
        nfi.CurrencyPositivePattern = 2; // "$ n"
        nfi.CurrencyNegativePattern = 2; // "($ n)"
        nfi.CurrencySymbol = "$";
        return precio.ToString("C", nfi);
    }
}
