@page "/login"
@using Usaditos2026.Server.Security
@using Usaditos2026.Servicios.Interfaces
@using Usaditos2026.Shared.DTOs
@using Usaditos2026.Shared.Seguridad
@inject IAuthServicio AuthServicio
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión | Usaditos Hernando</PageTitle>

<div class="auth-page-container">
    <div class="auth-split-card">
        <!-- Panel Izquierdo: Verde esmeralda con identidad, beneficios y formas lúdicas -->
        <aside class="auth-left-panel">
            <!-- Formas lúdicas y glows decorativos -->
            <div class="glow-shape glow-orange" aria-hidden="true"></div>
            <div class="glow-shape glow-yellow" aria-hidden="true"></div>
            <div class="playful-shape shape-orange" aria-hidden="true"></div>
            <div class="playful-shape shape-yellow" aria-hidden="true"></div>

            <!-- Cabecera de marca (en móvil se muestra solo esto como franja superior con el logo) -->
            <div class="panel-header-section">
                <div class="panel-top-nav">
                    <a class="panel-back-btn" href="/catalogo">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="19" y1="12" x2="5" y2="12"></line>
                            <polyline points="12 19 5 12 12 5"></polyline>
                        </svg>
                        <span>Volver a la tienda</span>
                    </a>
                    <span class="panel-location-chip d-none d-lg-inline-flex">
                        <span class="chip-dot" aria-hidden="true"></span>
                        Hernando, Córdoba
                    </span>
                </div>

                <div class="panel-brand-identity">
                    <div class="brand-avatar-circle" aria-hidden="true">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 3a2 2 0 0 1 2 2c0 1.1-.9 2-2 2a2 2 0 0 1-2-2 2 2 0 0 1 2-2z" />
                            <path d="M12 7v2" />
                            <path d="M2.5 16.5 12 9l9.5 7.5a1.5 1.5 0 0 1-.9 2.5H3.4a1.5 1.5 0 0 1-.9-2.5z" />
                        </svg>
                    </div>
                    <div class="brand-title-group">
                        <div class="brand-name-row">
                            <span class="brand-title-main">Usaditos Hernando</span>
                            <span class="brand-dot-accent" aria-hidden="true"></span>
                        </div>
                        <span class="brand-subtitle-tag">Ropa infantil con historia</span>
                    </div>
                </div>

                <div class="panel-editorial d-none d-lg-block">
                    <h1 class="panel-editorial-heading font-serif">
                        Ropa infantil con <span class="accent-italic">historia</span>
                    </h1>
                    <p class="panel-editorial-lead">
                        Moda circular y prendas únicas seleccionadas con cariño para acompañar los mejores momentos de la infancia en nuestra comunidad.
                    </p>
                </div>
            </div>

            <!-- Tres Beneficios de Confianza (Solo visibles en Desktop) -->
            <div class="panel-benefits-group d-none d-lg-flex">
                <div class="benefit-card">
                    <div class="benefit-icon-wrapper benefit-badge-yellow" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                        </svg>
                    </div>
                    <div class="benefit-content">
                        <h2 class="benefit-heading">Prendas únicas con curaduría minuciosa</h2>
                        <p class="benefit-description">Revisadas a mano, sanitizadas y como nuevas para tu tranquilidad.</p>
                    </div>
                </div>

                <div class="benefit-card">
                    <div class="benefit-icon-wrapper benefit-badge-orange" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                    </div>
                    <div class="benefit-content">
                        <h2 class="benefit-heading">Comprá y retirá fácil en Hernando</h2>
                        <p class="benefit-description">Retiro en el local o envío a coordinar.</p>
                    </div>
                </div>

                <div class="benefit-card">
                    <div class="benefit-icon-wrapper benefit-badge-green" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
                        </svg>
                    </div>
                    <div class="benefit-content">
                        <h2 class="benefit-heading">Consumo consciente que cuida tu bolsillo</h2>
                        <p class="benefit-description">Ahorrá hasta un 70% comparado a retail tradicional apoyando el planeta.</p>
                    </div>
                </div>
            </div>

            <!-- Pie del Panel Izquierdo (Desktop) -->
            <div class="panel-footer-row d-none d-lg-flex">
                <span>© @DateTime.Now.Year Usaditos Hernando</span>
                <span class="panel-love-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                    </svg>
                    Hecho con amor de madre
                </span>
            </div>
        </aside>

        <!-- Panel Derecho: Formulario sobre fondo crema (#FFFAEE) -->
        <section class="auth-right-panel" aria-label="Iniciar sesión">
            <div class="auth-right-content">

                <!-- Aviso informativo según destino (por ejemplo volver al catálogo para comprar) -->
                @if (!string.IsNullOrWhiteSpace(MensajeAviso))
                {
                    <div class="auth-notice-card" role="status">
                        <div class="notice-icon-box" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                                <line x1="3" y1="6" x2="21" y2="6"></line>
                                <path d="M16 10a4 4 0 0 1-8 0"></path>
                            </svg>
                        </div>
                        <div class="notice-body">
                            <span class="notice-title">Iniciá sesión para comprar</span>
                            <p class="notice-description">@MensajeAviso</p>
                        </div>
                    </div>
                }

                <!-- Alerta de error -->
                @if (!string.IsNullOrWhiteSpace(MensajeError))
                {
                    <div class="auth-error-card" role="alert">
                        <div class="error-icon-box" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                            </svg>
                        </div>
                        <div class="error-body">
                            <span class="error-title">@MensajeError</span>
                            <p class="error-description">Por favor revisá tus datos e intentá de nuevo.</p>
                        </div>
                    </div>
                }

                <!-- Tarjeta contenedora del formulario -->
                <div class="auth-form-card">
                    <div class="form-header-area">
                        <div class="form-kicker-tag">
                            <span>Boutique Circular</span>
                            <span class="kicker-dot">•</span>
                            <span>Acceso seguro</span>
                        </div>
                        <h2 class="form-title font-serif">Iniciar sesión</h2>
                        <p class="form-subtitle">Ingresá a tu cuenta para continuar con tus compras y pedidos.</p>
                    </div>

                    <EditForm Model="Modelo" OnValidSubmit="IngresarAsync" FormName="login">
                        <DataAnnotationsValidator />
                        <input type="hidden" name="ReturnUrlForm" value="@ReturnUrlForm" />

                        <!-- Campo Email -->
                        <div class="mb-3">
                            <label class="form-label auth-form-label" for="email">
                                <span>Correo electrónico</span>
                                <span class="label-aside-text">Obligatorio</span>
                            </label>
                            <div class="input-with-icon-wrapper">
                                <span class="input-leading-icon" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                        <polyline points="22,6 12,13 2,6"></polyline>
                                    </svg>
                                </span>
                                <InputText id="email" class="form-control auth-input" autocomplete="email" placeholder="ejemplo@correo.com" @bind-Value="Modelo!.Email" />
                            </div>
                            <ValidationMessage For="() => Modelo!.Email" />
                        </div>

                        <!-- Campo Contraseña con botón mostrar/ocultar -->
                        <div class="mb-4">
                            <label class="form-label auth-form-label" for="password">
                                <span>Contraseña</span>
                            </label>
                            <div class="input-with-icon-wrapper">
                                <span class="input-leading-icon" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                    </svg>
                                </span>
                                <InputText id="password" type="password" class="form-control auth-input has-toggle-btn" autocomplete="current-password" placeholder="Tu contraseña" @bind-Value="Modelo!.Password" />
                                <button type="button"
                                        id="toggle-password-btn"
                                        class="btn-toggle-password"
                                        aria-label="Mostrar contraseña"
                                        title="Mostrar u ocultar contraseña"
                                        onclick="const input = document.getElementById('password'); const isPass = input.type === 'password'; input.type = isPass ? 'text' : 'password'; this.setAttribute('aria-label', isPass ? 'Ocultar contraseña' : 'Mostrar contraseña'); this.querySelector('.eye-show').classList.toggle('d-none', isPass); this.querySelector('.eye-hide').classList.toggle('d-none', !isPass);">
                                    <svg class="eye-show" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                    <svg class="eye-hide d-none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                        <line x1="1" y1="1" x2="23" y2="23"></line>
                                    </svg>
                                </button>
                            </div>
                            <ValidationMessage For="() => Modelo!.Password" />
                        </div>

                        <!-- Botón Iniciar sesión -->
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-auth-submit">
                                <span>Iniciar sesión</span>
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                    <polyline points="12 5 19 12 12 19"></polyline>
                                </svg>
                            </button>
                        </div>

                        <!-- Enlace alternativo: Crear cuenta (preservando ReturnUrl) -->
                        <div class="auth-switch-section text-center">
                            <span class="auth-switch-text">¿No tenés cuenta?</span>
                            <a class="auth-switch-link fw-semibold ms-1" href="@UrlRegistro">
                                <span>Creá una</span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="9 18 15 12 9 6"></polyline>
                                </svg>
                            </a>
                        </div>
                    </EditForm>
                </div>

                <!-- Aviso de punto de retiro local -->
                <div class="pickup-info-note text-center">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <span>Retiro en el local o envío a coordinar</span>
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    private LoginRequest? Modelo { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromForm]
    private string? ReturnUrlForm { get; set; }

    private string? MensajeError;
    private string? MensajeAviso;

    private string UrlRegistro => string.IsNullOrWhiteSpace(ReturnUrlForm)
        ? "/registro"
        : $"/registro?returnUrl={Uri.EscapeDataString(ReturnUrlForm)}";

    protected override void OnInitialized()
    {
        Modelo ??= new();
        ReturnUrlForm ??= ReturnUrl;

        var destino = RetornoSeguro.ObtenerDestinoSeguro(ReturnUrlForm);
        MensajeAviso = destino switch
        {
            "/catalogo" => "Iniciá sesión para agregar productos al carrito.",
            "/" => null,
            _ => "Iniciá sesión para continuar."
        };
    }

    private async Task IngresarAsync()
    {
        MensajeError = null;

        if (HttpContext is null)
        {
            MensajeError = "No se pudo iniciar la sesión. Recargá la página.";
            return;
        }

        var modelo = Modelo!;
        var cliente = await AuthServicio.IniciarSesionAsync(modelo.Email, modelo.Password);

        if (cliente is null)
        {
            MensajeError = "Email o contraseña incorrectos.";
            return;
        }

        await AuthCookieHelper.IniciarSesionAsync(HttpContext, cliente);

        // Se valida el valor recibido en el POST, justo antes de redirigir (nunca el de la query).
        var destino = RetornoSeguro.ObtenerDestinoSeguro(ReturnUrlForm);
        Navigation.NavigateTo(destino, forceLoad: true);
    }
}
