@page "/login"
@using Usaditos2026.Server.Security
@using Usaditos2026.Servicios.Interfaces
@using Usaditos2026.Shared.DTOs
@inject IAuthServicio AuthServicio
@inject NavigationManager Navigation

<PageTitle>Ingresar</PageTitle>

<div class="form-angosto my-4">
    <div class="card auth-card">
        <div class="card-body p-4 p-sm-5">
            <div class="text-center mb-4">
                <div class="auth-icon-wrapper mb-2" aria-hidden="true">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                </div>
                <h1 class="auth-title h3 mb-1">Iniciar sesión</h1>
                <p class="auth-subtitle mb-0">Accedé a tu cuenta para continuar comprando</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(MensajeError))
            {
                <div class="alert alert-danger auth-alert d-flex align-items-start gap-2 mb-3" role="alert">
                    <svg class="flex-shrink-0 mt-1" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <span>@MensajeError</span>
                </div>
            }

            <EditForm Model="Modelo" OnValidSubmit="IngresarAsync" FormName="login">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label auth-label" for="email">Email</label>
                    <InputText id="email" class="form-control" autocomplete="email" @bind-Value="Modelo!.Email" />
                    <ValidationMessage For="() => Modelo!.Email" />
                </div>
                <div class="mb-4">
                    <label class="form-label auth-label" for="password">Contraseña</label>
                    <InputText id="password" type="password" class="form-control" autocomplete="current-password" @bind-Value="Modelo!.Password" />
                    <ValidationMessage For="() => Modelo!.Password" />
                </div>
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-auth-submit">Ingresar</button>
                </div>
                <p class="auth-switch-text text-center mt-3 mb-0">
                    ¿No tenés cuenta? <a class="auth-switch-link fw-semibold" href="/registro">Registrate</a>
                </p>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    private LoginRequest? Modelo { get; set; }

    private string? MensajeError;

    protected override void OnInitialized()
    {
        Modelo ??= new();
    }

    private async Task IngresarAsync()
    {
        MensajeError = null;

        if (HttpContext is null)
        {
            MensajeError = "No se pudo iniciar la sesión. Recargá la página.";
            return;
        }

        var modelo = Modelo!;
        var cliente = await AuthServicio.IniciarSesionAsync(modelo.Email, modelo.Password);

        if (cliente is null)
        {
            MensajeError = "Email o contraseña incorrectos.";
            return;
        }

        await AuthCookieHelper.IniciarSesionAsync(HttpContext, cliente);
        Navigation.NavigateTo("/", forceLoad: true);
    }
}
