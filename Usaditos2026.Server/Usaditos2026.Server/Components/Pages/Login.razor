@page "/login"
@using Usaditos2026.Server.Security
@using Usaditos2026.Servicios.Interfaces
@using Usaditos2026.Shared.DTOs
@inject IAuthServicio AuthServicio
@inject NavigationManager Navigation

<PageTitle>Ingresar</PageTitle>

<h1>Ingresar</h1>

@if (!string.IsNullOrWhiteSpace(MensajeError))
{
    <div class="alert alert-danger">@MensajeError</div>
}

<EditForm Model="Modelo" OnValidSubmit="IngresarAsync" FormName="login">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <InputText id="email" class="form-control" @bind-Value="Modelo!.Email" />
        <ValidationMessage For="() => Modelo!.Email" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="password">Contraseña</label>
        <InputText id="password" type="password" class="form-control" @bind-Value="Modelo!.Password" />
        <ValidationMessage For="() => Modelo!.Password" />
    </div>
    <button type="submit" class="btn btn-primary">Ingresar</button>
    <a class="btn btn-link" href="registro">Crear cuenta</a>
</EditForm>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    private LoginRequest? Modelo { get; set; }

    private string? MensajeError;

    protected override void OnInitialized()
    {
        Modelo ??= new();
    }

    private async Task IngresarAsync()
    {
        MensajeError = null;

        if (HttpContext is null)
        {
            MensajeError = "No se pudo iniciar la sesión. Recargá la página.";
            return;
        }

        var modelo = Modelo!;
        var cliente = await AuthServicio.IniciarSesionAsync(modelo.Email, modelo.Password);

        if (cliente is null)
        {
            MensajeError = "Email o contraseña incorrectos.";
            return;
        }

        await AuthCookieHelper.IniciarSesionAsync(HttpContext, cliente);
        Navigation.NavigateTo("/", forceLoad: true);
    }
}
