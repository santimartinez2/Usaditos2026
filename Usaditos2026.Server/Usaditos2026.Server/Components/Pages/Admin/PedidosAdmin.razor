@page "/admin/pedidos"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AutorizacionConstantes.PoliticaSoloAdmin)]
@layout AdminLayout
@using System.Globalization
@using Usaditos2026.Servicios.Interfaces
@using Usaditos2026.Shared.Constantes
@using Usaditos2026.Shared.DTOs
@using Usaditos2026.Shared.Utilidades
@inject IAdminPedidoServicio AdminPedidoServicio
@inject ITiendaServicio TiendaServicio
@inject NavigationManager Navigation

<PageTitle>Gestión de Pedidos · Panel de Administración | Usaditos Hernando</PageTitle>

<div class="admin-pedidos-page">
    <!-- Encabezado editorial -->
    <header class="page-header mb-4">
        <div class="d-inline-flex align-items-center gap-2 px-2.5 py-1 rounded-pill header-badge mb-2">
            <span class="live-dot" aria-hidden="true"></span>
            <span>Operaciones en vivo</span>
        </div>
        <h1 class="page-title font-serif">Gestión de Pedidos</h1>
        <p class="page-subtitle text-muted mb-0">
            Supervisá, filtrá y gestioná las compras y entregas en tiempo real para Usaditos Hernando.
        </p>
    </header>

    <!-- Barra de Filtros y Búsqueda -->
    <section class="filters-card mb-4" aria-label="Filtros de búsqueda de pedidos">
        <div class="row g-3 align-items-end">
            <!-- Búsqueda por texto (nombre / teléfono / email) -->
            <div class="col-12 col-md-4">
                <label for="filtro-texto" class="form-label">Buscar pedido</label>
                <div class="input-icon-wrap">
                    <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input id="filtro-texto"
                           type="text"
                           class="form-control"
                           placeholder="Nombre o teléfono..."
                           @bind="_texto"
                           @bind:event="oninput"
                           @onkeydown="HandleKeyDownAsync" />
                </div>
            </div>

            <!-- Estado del pedido -->
            <div class="col-6 col-md-2">
                <label for="filtro-estado" class="form-label">Estado</label>
                <select id="filtro-estado" class="form-select" @bind="_estado">
                    <option value="">Todos</option>
                    <option value="@PedidoConstantes.EstadoConfirmado">Confirmado</option>
                    <option value="@PedidoConstantes.EstadoListoParaRetirar">Listo para retirar</option>
                    <option value="@PedidoConstantes.EstadoEntregado">Entregado</option>
                    <option value="@PedidoConstantes.EstadoCancelado">Cancelado</option>
                </select>
            </div>

            <!-- Estado de pago -->
            <div class="col-6 col-md-2">
                <label for="filtro-pago" class="form-label">Cobro</label>
                <select id="filtro-pago" class="form-select" @bind="_estadoPagoString">
                    <option value="">Todos</option>
                    <option value="@nameof(EstadoPago.Pendiente)">Pago pendiente</option>
                    <option value="@nameof(EstadoPago.Pagado)">Pagado</option>
                </select>
            </div>

            <!-- Tipo de entrega -->
            <div class="col-6 col-md-2">
                <label for="filtro-entrega" class="form-label">Entrega</label>
                <select id="filtro-entrega" class="form-select" @bind="_tipoEntregaString">
                    <option value="">Todas</option>
                    <option value="@nameof(TipoEntrega.Retiro)">Retiro en local</option>
                    <option value="@nameof(TipoEntrega.Envio)">Envío a domicilio</option>
                </select>
            </div>

            <!-- Botones de acción de filtros -->
            <div class="col-6 col-md-2 d-flex gap-2">
                <button type="button" class="btn btn-primary flex-grow-1" @onclick="AplicarFiltrosAsync">
                    Filtrar
                </button>
                <button type="button" class="btn btn-outline-secondary" title="Limpiar filtros" @onclick="LimpiarFiltrosAsync">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                        <path d="M3 3v5h5"></path>
                    </svg>
                </button>
            </div>

            <!-- Rango de Fechas -->
            <div class="col-12 col-md-6 pt-1">
                <div class="row g-2 align-items-center">
                    <div class="col-6">
                        <label for="filtro-desde" class="form-label">Fecha desde</label>
                        <input id="filtro-desde" type="date" class="form-control" @bind="_fechaDesde" />
                    </div>
                    <div class="col-6">
                        <label for="filtro-hasta" class="form-label">Fecha hasta</label>
                        <input id="filtro-hasta" type="date" class="form-control" @bind="_fechaHasta" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contenedor de Datos: Estados de carga, error y lista -->
    @if (_cargando)
    {
        <div class="loading-container text-center py-5" role="status" aria-live="polite">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando pedidos...</span>
            </div>
            <p class="mt-3 text-muted">Cargando el listado de pedidos...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_mensajeError))
    {
        <div class="alert alert-danger d-flex align-items-center justify-content-between p-3" role="alert">
            <div class="d-flex align-items-center gap-2">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>@_mensajeError</span>
            </div>
            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="CargarPedidosAsync">Reintentar</button>
        </div>
    }
    else if (_pedidos.Count == 0)
    {
        <div class="empty-state-box text-center py-5">
            <div class="empty-icon-wrap mb-3" aria-hidden="true">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="21 8 21 21 3 21 3 8"></polyline>
                    <rect x="1" y="3" width="22" height="5"></rect>
                    <line x1="10" y1="12" x2="14" y2="12"></line>
                </svg>
            </div>
            <h3 class="font-serif">No se encontraron pedidos</h3>
            <p class="text-muted max-w-md mx-auto">
                No hay pedidos registrados con los filtros seleccionados. Intentá modificarlos o limpiá los filtros para ver todos.
            </p>
            <button type="button" class="btn btn-outline-primary mt-2" @onclick="LimpiarFiltrosAsync">
                Limpiar filtros
            </button>
        </div>
    }
    else
    {
        <!-- Vista Desktop: Tabla completa -->
        <div class="table-card d-none d-lg-block mb-4">
            <div class="table-responsive">
                <table class="table align-middle admin-orders-table mb-0">
                    <thead>
                        <tr>
                            <th scope="col" class="th-id"># Pedido</th>
                            <th scope="col">Fecha y Hora</th>
                            <th scope="col">Cliente</th>
                            <th scope="col">Entrega</th>
                            <th scope="col">Pago</th>
                            <th scope="col">Estado</th>
                            <th scope="col">Cobro</th>
                            <th scope="col" class="text-end">Total</th>
                            <th scope="col" class="text-center th-action">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pedido in _pedidos)
                        {
                            <tr class="order-row">
                                <td class="td-id">
                                    <span class="order-number font-serif">#@pedido.Id</span>
                                </td>
                                <td>
                                    <div class="d-flex flex-col">
                                        <span class="order-date-main">@FormatearFechaCorta(pedido.Fecha)</span>
                                        <span class="order-date-sub text-muted">@FormatearHora(pedido.Fecha)</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="customer-avatar" aria-hidden="true">
                                            @ObtenerIniciales(pedido.ClienteNombre)
                                        </div>
                                        <div class="d-flex flex-column min-w-0">
                                            <span class="customer-name text-truncate">@pedido.ClienteNombre</span>
                                            <span class="customer-sub text-muted text-truncate">@pedido.TelefonoContacto</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="delivery-pill">
                                        @if (pedido.TipoEntrega == TipoEntrega.Retiro)
                                        {
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                                <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                            </svg>
                                            <span>Retiro en local</span>
                                        }
                                        else
                                        {
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <rect x="1" y="3" width="15" height="13"></rect>
                                                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                                                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                                <circle cx="18.5" cy="18.5" r="2.5"></circle>
                                            </svg>
                                            <span>Envío a domicilio</span>
                                        }
                                    </span>
                                </td>
                                <td>
                                    <span class="payment-method-text">@ObtenerNombreMetodoPago(pedido.MetodoPago)</span>
                                </td>
                                <td>
                                    <span class="chip-estado @ObtenerClaseChipEstado(pedido.Estado)">
                                        <span class="chip-dot" aria-hidden="true"></span>
                                        <span>@ObtenerTextoEstado(pedido.Estado)</span>
                                    </span>
                                </td>
                                <td>
                                    <span class="chip-pago @ObtenerClaseChipPago(pedido.EstadoPago)">
                                        <span>@ObtenerTextoPago(pedido.EstadoPago)</span>
                                    </span>
                                </td>
                                <td class="text-end">
                                    <span class="order-total font-serif">@pedido.Total.ToString("C", _culturaAr)</span>
                                </td>
                                <td class="text-center">
                                    <a href="/admin/pedidos/@pedido.Id" class="btn btn-ver-pedido" title="Ver detalle del pedido #@pedido.Id">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>
                                        <span>Ver</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Vista Móvil: Tarjetas compactas y limpias (< 992px) -->
        <div class="mobile-orders-list d-lg-none mb-4">
            @foreach (var pedido in _pedidos)
            {
                <article class="mobile-order-card">
                    <div class="card-top-row">
                        <span class="order-number font-serif">#@pedido.Id</span>
                        <span class="order-date-sub text-muted">@FormatearFechaLista(pedido.Fecha)</span>
                    </div>

                    <div class="card-customer-row">
                        <div class="customer-avatar" aria-hidden="true">
                            @ObtenerIniciales(pedido.ClienteNombre)
                        </div>
                        <div class="d-flex flex-column min-w-0">
                            <span class="customer-name text-truncate">@pedido.ClienteNombre</span>
                            <span class="customer-sub text-muted">@pedido.TelefonoContacto</span>
                        </div>
                    </div>

                    <div class="card-chips-row">
                        <span class="chip-estado @ObtenerClaseChipEstado(pedido.Estado)">
                            <span class="chip-dot" aria-hidden="true"></span>
                            <span>@ObtenerTextoEstado(pedido.Estado)</span>
                        </span>
                        <span class="chip-pago @ObtenerClaseChipPago(pedido.EstadoPago)">
                            <span>@ObtenerTextoPago(pedido.EstadoPago)</span>
                        </span>
                        <span class="delivery-pill">
                            <span>@(pedido.TipoEntrega == TipoEntrega.Retiro ? "Retiro" : "Envío")</span>
                        </span>
                    </div>

                    <div class="card-bottom-row">
                        <div>
                            <span class="order-total-label text-muted">Total:</span>
                            <span class="order-total font-serif ms-1">@pedido.Total.ToString("C", _culturaAr)</span>
                        </div>
                        <a href="/admin/pedidos/@pedido.Id" class="btn btn-ver-pedido">
                            <span>Ver detalle</span>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </a>
                    </div>
                </article>
            }
        </div>

        <!-- Paginación -->
        @if (_totalPaginas > 1 || _totalRegistros > 0)
        {
            <div class="pagination-footer d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3">
                <div class="pagination-info text-muted">
                    Mostrando <strong class="text-main">@ObtenerRangoMostrado()</strong> de <strong class="text-main">@_totalRegistros</strong> pedidos
                </div>

                <div class="pagination-controls d-flex align-items-center gap-1">
                    <button type="button"
                            class="btn btn-page"
                            disabled="@(_paginaActual <= 1)"
                            @onclick="() => CambiarPaginaAsync(_paginaActual - 1)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                        <span class="d-none d-sm-inline ms-1">Anterior</span>
                    </button>

                    @for (int i = 1; i <= _totalPaginas; i++)
                    {
                        var p = i;
                        if (p == 1 || p == _totalPaginas || (p >= _paginaActual - 1 && p <= _paginaActual + 1))
                        {
                            <button type="button"
                                    class="btn btn-page-number @(p == _paginaActual ? "active" : "")"
                                    @onclick="() => CambiarPaginaAsync(p)">
                                @p
                            </button>
                        }
                        else if (p == _paginaActual - 2 || p == _paginaActual + 2)
                        {
                            <span class="pagination-ellipsis px-1 text-muted">…</span>
                        }
                    }

                    <button type="button"
                            class="btn btn-page"
                            disabled="@(_paginaActual >= _totalPaginas)"
                            @onclick="() => CambiarPaginaAsync(_paginaActual + 1)">
                        <span class="d-none d-sm-inline me-1">Siguiente</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<PedidoAdminResumenDto> _pedidos = new();
    private TiendaInfoDto? _tiendaInfo;

    private bool _cargando = true;
    private string? _mensajeError;

    // Filtros
    private string? _texto;
    private string? _estado;
    private string? _estadoPagoString;
    private string? _tipoEntregaString;
    private DateOnly? _fechaDesde;
    private DateOnly? _fechaHasta;

    // Paginación
    private int _paginaActual = 1;
    private const int _tamanioPagina = 10;
    private int _totalRegistros;
    private int _totalPaginas => (int)Math.Ceiling((double)_totalRegistros / _tamanioPagina);

    private readonly CultureInfo _culturaAr = new("es-AR");

    protected override async Task OnInitializedAsync()
    {
        _tiendaInfo = TiendaServicio.ObtenerInfo();
        await CargarPedidosAsync();
    }

    private async Task CargarPedidosAsync()
    {
        try
        {
            _cargando = true;
            _mensajeError = null;

            EstadoPago? estadoPago = !string.IsNullOrWhiteSpace(_estadoPagoString) && Enum.TryParse<EstadoPago>(_estadoPagoString, out var ep)
                ? ep
                : null;

            TipoEntrega? tipoEntrega = !string.IsNullOrWhiteSpace(_tipoEntregaString) && Enum.TryParse<TipoEntrega>(_tipoEntregaString, out var te)
                ? te
                : null;

            // Instancia limpia para cada consulta (evita conversiones UTC redundantes)
            var filtros = new PedidoAdminFiltrosDto
            {
                Texto = string.IsNullOrWhiteSpace(_texto) ? null : _texto.Trim(),
                Estado = string.IsNullOrWhiteSpace(_estado) ? null : _estado.Trim(),
                EstadoPago = estadoPago,
                TipoEntrega = tipoEntrega,
                FechaDesde = _fechaDesde.HasValue ? _fechaDesde.Value.ToDateTime(TimeOnly.MinValue) : null,
                FechaHasta = _fechaHasta.HasValue ? _fechaHasta.Value.ToDateTime(TimeOnly.MinValue) : null,
                Page = _paginaActual,
                PageSize = _tamanioPagina
            };

            var resultado = await AdminPedidoServicio.ObtenerPedidosAsync(filtros);

            _pedidos = resultado.Items ?? new List<PedidoAdminResumenDto>();
            _totalRegistros = resultado.Total;
        }
        catch (Exception ex)
        {
            _mensajeError = "No se pudieron cargar los pedidos: " + ex.Message;
            _pedidos = new();
            _totalRegistros = 0;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task AplicarFiltrosAsync()
    {
        _paginaActual = 1;
        await CargarPedidosAsync();
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AplicarFiltrosAsync();
        }
    }

    private async Task LimpiarFiltrosAsync()
    {
        _texto = null;
        _estado = null;
        _estadoPagoString = null;
        _tipoEntregaString = null;
        _fechaDesde = null;
        _fechaHasta = null;
        _paginaActual = 1;
        await CargarPedidosAsync();
    }

    private async Task CambiarPaginaAsync(int nuevaPagina)
    {
        if (nuevaPagina < 1 || nuevaPagina > _totalPaginas || nuevaPagina == _paginaActual)
            return;

        _paginaActual = nuevaPagina;
        await CargarPedidosAsync();
    }

    private string ObtenerRangoMostrado()
    {
        if (_totalRegistros == 0) return "0";
        var inicio = (_paginaActual - 1) * _tamanioPagina + 1;
        var fin = Math.Min(_paginaActual * _tamanioPagina, _totalRegistros);
        return $"{inicio} - {fin}";
    }

    private string FormatearFechaCorta(DateTime fechaUtc)
    {
        var zonaId = !string.IsNullOrWhiteSpace(_tiendaInfo?.ZonaHoraria)
            ? _tiendaInfo.ZonaHoraria
            : FechaHelper.ZonaPorDefecto;

        var local = FechaHelper.UtcALocal(fechaUtc, zonaId);
        return local.ToString("dd/MM/yyyy", _culturaAr);
    }

    private string FormatearHora(DateTime fechaUtc)
    {
        var zonaId = !string.IsNullOrWhiteSpace(_tiendaInfo?.ZonaHoraria)
            ? _tiendaInfo.ZonaHoraria
            : FechaHelper.ZonaPorDefecto;

        var local = FechaHelper.UtcALocal(fechaUtc, zonaId);
        return local.ToString("HH:mm", _culturaAr) + " hs";
    }

    private string FormatearFechaLista(DateTime fechaUtc)
    {
        var zonaId = !string.IsNullOrWhiteSpace(_tiendaInfo?.ZonaHoraria)
            ? _tiendaInfo.ZonaHoraria
            : FechaHelper.ZonaPorDefecto;

        var local = FechaHelper.UtcALocal(fechaUtc, zonaId);
        return local.ToString("dd/MM/yyyy · HH:mm", _culturaAr) + " hs";
    }

    private static string ObtenerIniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "CL";
        var partes = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length >= 2)
        {
            return $"{char.ToUpper(partes[0][0])}{char.ToUpper(partes[1][0])}";
        }
        return partes[0].Length >= 2 ? partes[0].Substring(0, 2).ToUpper() : partes[0].ToUpper();
    }

    private static string ObtenerNombreMetodoPago(MetodoPago metodo)
    {
        return metodo switch
        {
            MetodoPago.Efectivo => "Efectivo",
            MetodoPago.Transferencia => "Transferencia",
            _ => metodo.ToString()
        };
    }

    private static string ObtenerTextoEstado(string estado)
    {
        return estado switch
        {
            PedidoConstantes.EstadoConfirmado => "Confirmado",
            PedidoConstantes.EstadoListoParaRetirar => "Listo para retirar",
            PedidoConstantes.EstadoEntregado => "Entregado",
            PedidoConstantes.EstadoCancelado => "Cancelado",
            _ => estado
        };
    }

    private static string ObtenerClaseChipEstado(string estado)
    {
        return estado switch
        {
            PedidoConstantes.EstadoConfirmado => "chip-confirmado",
            PedidoConstantes.EstadoListoParaRetirar => "chip-listo",
            PedidoConstantes.EstadoEntregado => "chip-entregado",
            PedidoConstantes.EstadoCancelado => "chip-cancelado",
            _ => "chip-confirmado"
        };
    }

    private static string ObtenerTextoPago(EstadoPago estado)
    {
        return estado switch
        {
            EstadoPago.Pagado => "Pagado",
            _ => "Pendiente"
        };
    }

    private static string ObtenerClaseChipPago(EstadoPago estado)
    {
        return estado switch
        {
            EstadoPago.Pagado => "pago-pagado",
            _ => "pago-pendiente"
        };
    }
}
