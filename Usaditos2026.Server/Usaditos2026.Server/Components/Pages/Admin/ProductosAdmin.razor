@page "/admin/productos"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AutorizacionConstantes.PoliticaSoloAdmin)]
@layout AdminLayout
@using System.Globalization
@using Usaditos2026.Servicios.Interfaces
@using Usaditos2026.Shared.Constantes
@using Usaditos2026.Shared.DTOs
@using Usaditos2026.Shared.Excepciones
@using Usaditos2026.Shared.Utilidades
@inject IAdminCatalogoServicio AdminCatalogoServicio
@inject NavigationManager Navigation

<PageTitle>Gestión de Productos · Panel de Administración | Usaditos Hernando</PageTitle>

<div class="admin-productos-page">
    <!-- Encabezado editorial -->
    <header class="page-header mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div>
                <div class="d-inline-flex align-items-center gap-2 px-2.5 py-1 rounded-pill header-badge mb-2">
                    <span class="live-dot" aria-hidden="true"></span>
                    <span>Catálogo Circular • Usaditos Hernando</span>
                </div>
                <h1 class="page-title font-serif">Gestión de Productos</h1>
                <p class="page-subtitle text-muted mb-0">
                    Administrá el catálogo de prendas, actualizá talles, precios y disponibilidad en tiempo real con curaduría consciente.
                </p>
            </div>
            <div class="shrink-0">
                <a href="/admin/productos/nuevo" class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2.5 shadow-sm">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    <span>Nuevo producto</span>
                </a>
            </div>
        </div>
    </header>

    <!-- Avisos de Concurrencia y Errores -->
    @if (_errorConcurrencia)
    {
        <div class="alert alert-warning d-flex align-items-center justify-content-between p-3 rounded-3 mb-4 shadow-sm" role="alert">
            <div class="d-flex align-items-center gap-2">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-warning shrink-0" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <div>
                    <strong>El producto fue modificado, recargá</strong>
                    <div class="small text-muted">Otro administrador o proceso actualizó los datos de este producto. Por favor recargá la lista para obtener la versión más reciente.</div>
                </div>
            </div>
            <button type="button" class="btn btn-sm btn-outline-dark" @onclick="CargarDatosAsync">
                Recargar productos
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_mensajeError))
    {
        <div class="alert alert-danger d-flex align-items-center justify-content-between p-3 rounded-3 mb-4 shadow-sm" role="alert">
            <div class="d-flex align-items-center gap-2">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-danger shrink-0" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
                <span>@_mensajeError</span>
            </div>
            <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => _mensajeError = null"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_mensajeExito))
    {
        <div class="alert alert-success d-flex align-items-center justify-content-between p-3 rounded-3 mb-4 shadow-sm" role="alert">
            <div class="d-flex align-items-center gap-2">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success shrink-0" aria-hidden="true">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                <span>@_mensajeExito</span>
            </div>
            <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => _mensajeExito = null"></button>
        </div>
    }

    <!-- Barra de Filtros y Búsqueda -->
    <section class="filters-card mb-4" aria-label="Filtros de catálogo de productos">
        <div class="row g-3 align-items-end">
            <!-- Búsqueda de texto -->
            <div class="col-12 col-md-5">
                <label for="filtro-texto" class="form-label">Buscar producto</label>
                <div class="input-icon-wrap">
                    <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input id="filtro-texto"
                           type="text"
                           class="form-control"
                           placeholder="Buscar por nombre o descripción..."
                           @bind="_textoBusqueda"
                           @bind:event="oninput" />
                </div>
            </div>

            <!-- Filtro de Categoría -->
            <div class="col-12 col-sm-6 col-md-3">
                <label for="filtro-categoria" class="form-label">Categoría</label>
                <select id="filtro-categoria" class="form-select" @bind="_categoriaSeleccionadaId">
                    <option value="0">Todas las categorías</option>
                    @foreach (var cat in _categorias)
                    {
                        <option value="@cat.Id">@cat.Nombre</option>
                    }
                </select>
            </div>

            <!-- Filtro de Estado Activo -->
            <div class="col-12 col-sm-6 col-md-3">
                <label for="filtro-estado" class="form-label">Estado de publicación</label>
                <select id="filtro-estado" class="form-select" @bind="_estadoActivoFiltro">
                    <option value="">Todos los estados</option>
                    <option value="activos">Solo Activos</option>
                    <option value="inactivos">Solo Pausados / Inactivos</option>
                </select>
            </div>

            <!-- Botón Limpiar Filtros -->
            <div class="col-12 col-md-1 d-flex">
                <button type="button" class="btn btn-outline-secondary w-100" title="Limpiar filtros" @onclick="LimpiarFiltros">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                        <path d="M3 3v5h5"></path>
                    </svg>
                </button>
            </div>
        </div>
    </section>

    <!-- Lista de Productos -->
    @if (_cargando)
    {
        <div class="table-card p-5 text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando productos...</span>
            </div>
            <p class="text-muted mt-2 mb-0">Cargando catálogo de productos...</p>
        </div>
    }
    else if (!ProductosFiltrados.Any())
    {
        <div class="table-card p-5 text-center">
            <div class="empty-icon-wrap mb-3 mx-auto">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-muted" aria-hidden="true">
                    <path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"></path>
                </svg>
            </div>
            <h3 class="h5 font-serif text-main mb-1">No se encontraron productos</h3>
            <p class="text-muted small mb-3">Probá cambiando los términos de búsqueda o los filtros aplicados.</p>
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="LimpiarFiltros">
                Restablecer filtros
            </button>
        </div>
    }
    else
    {
        <!-- Vista Desktop (Tabla) -->
        <div class="table-card d-none d-md-block">
            <div class="table-responsive">
                <table class="table admin-products-table mb-0 align-middle">
                    <thead>
                        <tr>
                            <th scope="col" class="th-foto">Foto</th>
                            <th scope="col">Nombre</th>
                            <th scope="col">Categoría</th>
                            <th scope="col">Talle</th>
                            <th scope="col">Estado</th>
                            <th scope="col" class="text-end">Precio</th>
                            <th scope="col" class="text-center">Stock</th>
                            <th scope="col" class="text-center">Activo</th>
                            <th scope="col" class="text-end th-acciones">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prod in ProductosFiltrados)
                        {
                            <tr class="@(prod.Activo ? "" : "row-inactiva")">
                                <!-- Foto miniatura -->
                                <td class="td-foto">
                                    <div class="prod-thumb">
                                        @if (!string.IsNullOrWhiteSpace(prod.ImagenUrl))
                                        {
                                            <img src="@prod.ImagenUrl" alt="@prod.Nombre" class="thumb-img" />
                                        }
                                        else
                                        {
                                            <div class="thumb-placeholder" title="Sin foto">
                                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                                    <polyline points="21 15 16 10 5 21"></polyline>
                                                </svg>
                                            </div>
                                        }
                                    </div>
                                </td>

                                <!-- Nombre -->
                                <td>
                                    <div class="prod-nombre-wrap">
                                        <a href="/admin/productos/@prod.Id" class="prod-nombre font-serif" title="Editar producto">
                                            @prod.Nombre
                                        </a>
                                        @if (!string.IsNullOrWhiteSpace(prod.Observaciones))
                                        {
                                            <span class="prod-observacion text-muted" title="@prod.Observaciones">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <circle cx="12" cy="12" r="10"></circle>
                                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                                </svg>
                                                @prod.Observaciones
                                            </span>
                                        }
                                    </div>
                                </td>

                                <!-- Categoría -->
                                <td>
                                    <span class="badge-categoria">
                                        @(string.IsNullOrWhiteSpace(prod.NombreCategoria) ? "Sin categoría" : prod.NombreCategoria)
                                    </span>
                                </td>

                                <!-- Talle -->
                                <td>
                                    <span class="badge-talle">
                                        @TalleTextoHelper.ObtenerTexto(prod.Talle)
                                    </span>
                                </td>

                                <!-- Estado de prenda -->
                                <td>
                                    <span class="badge-estado-prenda estado-@prod.Estado.ToLowerInvariant()">
                                        <span class="estado-dot"></span>
                                        @prod.EstadoTexto
                                    </span>
                                </td>

                                <!-- Precio -->
                                <td class="text-end">
                                    <span class="prod-precio font-serif">
                                        @prod.Precio.ToString("C", _culturaAr)
                                    </span>
                                </td>

                                <!-- Stock -->
                                <td class="text-center">
                                    @if (prod.StockDisponible > 0)
                                    {
                                        <span class="badge-stock">
                                            @prod.StockDisponible u.
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-stock stock-cero">
                                            Sin stock
                                        </span>
                                    }
                                </td>

                                <!-- Interruptor Activo -->
                                <td class="text-center">
                                    <div class="form-check form-switch d-inline-block m-0">
                                        <input class="form-check-input switch-activo"
                                               type="checkbox"
                                               role="switch"
                                               id="switch-prod-@prod.Id"
                                               checked="@prod.Activo"
                                               disabled="@(_procesandoId == prod.Id)"
                                               @onchange="() => CambiarEstadoActivoAsync(prod)"
                                               title="@(prod.Activo ? "Desactivar producto" : "Activar producto")" />
                                    </div>
                                </td>

                                <!-- Acciones -->
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a href="/admin/productos/@prod.Id" class="btn btn-action" title="Editar producto">
                                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                            </svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pie de tabla con total -->
            <div class="table-footer d-flex justify-content-between align-items-center px-4 py-3">
                <span class="text-muted small">
                    Mostrando <strong>@ProductosFiltrados.Count</strong> de <strong>@_productos.Count</strong> productos
                </span>
            </div>
        </div>

        <!-- Vista Móvil (Tarjetas limpias) -->
        <div class="d-md-none mobile-products-list">
            @foreach (var prod in ProductosFiltrados)
            {
                <div class="mobile-prod-card @(prod.Activo ? "" : "card-inactiva") mb-3">
                    <div class="d-flex gap-3 align-items-start">
                        <div class="prod-thumb shrink-0">
                            @if (!string.IsNullOrWhiteSpace(prod.ImagenUrl))
                            {
                                <img src="@prod.ImagenUrl" alt="@prod.Nombre" class="thumb-img" />
                            }
                            else
                            {
                                <div class="thumb-placeholder" title="Sin foto">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                        <polyline points="21 15 16 10 5 21"></polyline>
                                    </svg>
                                </div>
                            }
                        </div>

                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <a href="/admin/productos/@prod.Id" class="prod-nombre font-serif text-truncate d-block">
                                    @prod.Nombre
                                </a>
                                <span class="prod-precio font-serif shrink-0">
                                    @prod.Precio.ToString("C", _culturaAr)
                                </span>
                            </div>

                            <div class="d-flex flex-wrap gap-1.5 align-items-center mt-1 mb-2">
                                <span class="badge-categoria">@prod.NombreCategoria</span>
                                <span class="badge-talle">@TalleTextoHelper.ObtenerTexto(prod.Talle)</span>
                                <span class="badge-estado-prenda estado-@prod.Estado.ToLowerInvariant()">
                                    @prod.EstadoTexto
                                </span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-2 border-top border-soft">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-muted small">Stock:</span>
                                    <span class="badge-stock @(prod.StockDisponible == 0 ? "stock-cero" : "")">
                                        @(prod.StockDisponible > 0 ? $"{prod.StockDisponible} u." : "Sin stock")
                                    </span>
                                </div>

                                <div class="d-flex align-items-center gap-3">
                                    <div class="form-check form-switch m-0" title="Activar/Desactivar">
                                        <input class="form-check-input switch-activo"
                                               type="checkbox"
                                               role="switch"
                                               checked="@prod.Activo"
                                               disabled="@(_procesandoId == prod.Id)"
                                               @onchange="() => CambiarEstadoActivoAsync(prod)" />
                                    </div>

                                    <a href="/admin/productos/@prod.Id" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                        </svg>
                                        <span>Editar</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<ProductoAdminDto> _productos = new();
    private List<CategoriaDto> _categorias = new();
    private bool _cargando = true;
    private int? _procesandoId;

    // Filtros
    private string _textoBusqueda = string.Empty;
    private int _categoriaSeleccionadaId = 0;
    private string _estadoActivoFiltro = string.Empty;

    // Avisos
    private bool _errorConcurrencia;
    private string? _mensajeError;
    private string? _mensajeExito;

    private readonly CultureInfo _culturaAr = CultureInfo.GetCultureInfo("es-AR");

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        _cargando = true;
        _errorConcurrencia = false;
        _mensajeError = null;

        try
        {
            _categorias = await AdminCatalogoServicio.ObtenerCategoriasAsync();
            _productos = await AdminCatalogoServicio.ObtenerProductosAsync();
        }
        catch (Exception ex)
        {
            _mensajeError = $"Error al cargar los datos: {ex.Message}";
        }
        finally
        {
            _cargando = false;
        }
    }

    private List<ProductoAdminDto> ProductosFiltrados
    {
        get
        {
            var resultado = _productos.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_textoBusqueda))
            {
                var query = _textoBusqueda.Trim().ToLowerInvariant();
                resultado = resultado.Where(p =>
                    (!string.IsNullOrEmpty(p.Nombre) && p.Nombre.ToLowerInvariant().Contains(query)) ||
                    (!string.IsNullOrEmpty(p.Descripcion) && p.Descripcion.ToLowerInvariant().Contains(query)) ||
                    (!string.IsNullOrEmpty(p.Observaciones) && p.Observaciones.ToLowerInvariant().Contains(query))
                );
            }

            if (_categoriaSeleccionadaId > 0)
            {
                resultado = resultado.Where(p => p.CategoriaId == _categoriaSeleccionadaId);
            }

            if (_estadoActivoFiltro == "activos")
            {
                resultado = resultado.Where(p => p.Activo);
            }
            else if (_estadoActivoFiltro == "inactivos")
            {
                resultado = resultado.Where(p => !p.Activo);
            }

            return resultado.ToList();
        }
    }

    private void LimpiarFiltros()
    {
        _textoBusqueda = string.Empty;
        _categoriaSeleccionadaId = 0;
        _estadoActivoFiltro = string.Empty;
    }

    private async Task CambiarEstadoActivoAsync(ProductoAdminDto prod)
    {
        _errorConcurrencia = false;
        _mensajeError = null;
        _mensajeExito = null;
        _procesandoId = prod.Id;

        try
        {
            if (prod.Activo)
            {
                // Desactivar
                await AdminCatalogoServicio.DesactivarProductoAsync(prod.Id, prod.RowVersion);
                var actualizado = await AdminCatalogoServicio.ObtenerProductoAsync(prod.Id);
                prod.RowVersion = actualizado.RowVersion;
                prod.Activo = actualizado.Activo;
                _mensajeExito = $"Se desactivó la prenda '{prod.Nombre}'.";
            }
            else
            {
                // Activar
                var actualizado = await AdminCatalogoServicio.ActivarProductoAsync(prod.Id, prod.RowVersion);
                prod.RowVersion = actualizado.RowVersion;
                prod.Activo = actualizado.Activo;
                _mensajeExito = $"Se activó la prenda '{prod.Nombre}'.";
            }
        }
        catch (ProductoModificadoException)
        {
            _errorConcurrencia = true;
            _mensajeError = "El producto fue modificado, recargá";
        }
        catch (Exception ex)
        {
            _mensajeError = $"Error al cambiar estado: {ex.Message}";
        }
        finally
        {
            _procesandoId = null;
        }
    }
}
