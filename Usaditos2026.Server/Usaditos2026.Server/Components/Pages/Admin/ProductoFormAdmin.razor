@page "/admin/productos/nuevo"
@page "/admin/productos/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AutorizacionConstantes.PoliticaSoloAdmin)]
@layout AdminLayout
@using System.Globalization
@using System.IO
@using Usaditos2026.Servicios.Interfaces
@using Usaditos2026.Shared.Constantes
@using Usaditos2026.Shared.DTOs
@using Usaditos2026.Shared.Excepciones
@using Usaditos2026.Shared.Utilidades
@inject IAdminCatalogoServicio AdminCatalogoServicio
@inject NavigationManager Navigation

<PageTitle>@(EsEdicion ? "Editar Producto" : "Nuevo Producto") · Panel de Administración | Usaditos Hernando</PageTitle>

<div class="admin-producto-form-page">
    <!-- Navegación superior -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <a href="/admin/productos" class="back-link d-inline-flex align-items-center gap-1.5 font-sans">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Volver a la lista de productos</span>
        </a>

        @if (EsEdicion && _productoCargado != null)
        {
            <div class="d-inline-flex align-items-center gap-2">
                <span class="badge-estado-header @(_activo ? "activo" : "inactivo")">
                    <span class="estado-dot"></span>
                    @(_activo ? "Producto activo en tienda" : "Producto pausado")
                </span>
            </div>
        }
    </div>

    <!-- Título de la página -->
    <header class="page-header mb-4">
        <h1 class="page-title font-serif">
            @(EsEdicion ? $"Editar Producto: {_nombre}" : "Nuevo Producto")
        </h1>
        <p class="page-subtitle text-muted mb-0">
            @(EsEdicion
                ? "Actualizá la información, fotografía y disponibilidad de esta prenda en el catálogo."
                : "Completá los datos y subí una fotografía para publicar una nueva prenda en el catálogo.")
        </p>
    </header>

    <!-- Banner de Conflicto de Concurrencia -->
    @if (_errorConcurrencia)
    {
        <div class="concurrency-banner rounded-3 p-3.5 mb-4 shadow-sm" role="alert">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="concurrency-icon-wrap shrink-0">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="font-bold text-dark mb-0.5">El producto fue modificado, recargá</div>
                        <div class="small text-muted">Otro administrador guardó cambios en esta prenda recientemente. Recargá los datos para ver la información más actual y evitar sobreescrituras.</div>
                    </div>
                </div>
                <button type="button" class="btn btn-sm btn-dark shrink-0" @onclick="RecargarProductoAsync">
                    Recargar producto
                </button>
            </div>
        </div>
    }

    <!-- Alertas generales -->
    @if (!string.IsNullOrWhiteSpace(_mensajeError))
    {
        <div class="alert alert-danger d-flex align-items-center justify-content-between p-3 rounded-3 mb-4 shadow-sm" role="alert">
            <div class="d-flex align-items-center gap-2">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-danger shrink-0" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
                <span>@_mensajeError</span>
            </div>
            <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => _mensajeError = null"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_mensajeExito))
    {
        <div class="alert alert-success d-flex align-items-center justify-content-between p-3 rounded-3 mb-4 shadow-sm" role="alert">
            <div class="d-flex align-items-center gap-2">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success shrink-0" aria-hidden="true">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                <span>@_mensajeExito</span>
            </div>
            <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => _mensajeExito = null"></button>
        </div>
    }

    @if (_cargandoInicial)
    {
        <div class="form-card p-5 text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="text-muted mt-2 mb-0">Cargando datos del producto...</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- COLUMNA IZQUIERDA: Fotografía y Acciones Principales (5 cols) -->
            <div class="col-12 col-lg-5 d-flex flex-column gap-4">
                <!-- Card: Fotografía -->
                <div class="form-card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary" aria-hidden="true">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                <polyline points="21 15 16 10 5 21"></polyline>
                            </svg>
                            <h2 class="card-section-title font-serif m-0">Fotografía de la prenda</h2>
                        </div>
                        <span class="badge-card-pill">Principal</span>
                    </div>

                    <!-- Zona de Vista Previa -->
                    <div class="photo-preview-wrap mb-3 position-relative">
                        @if (!string.IsNullOrWhiteSpace(_previewDataUrl))
                        {
                            <img src="@_previewDataUrl" alt="Vista previa seleccionada" class="photo-preview-img" />
                            <div class="photo-badge-preview">Foto nueva seleccionada</div>
                        }
                        else if (!string.IsNullOrWhiteSpace(_imagenUrl))
                        {
                            <img src="@_imagenUrl" alt="Imagen actual del producto" class="photo-preview-img" />
                            <div class="photo-badge-server">Foto guardada</div>
                        }
                        else
                        {
                            <div class="photo-placeholder-box">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="text-muted mb-2" aria-hidden="true">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                    <polyline points="21 15 16 10 5 21"></polyline>
                                </svg>
                                <span class="text-muted small">Sin fotografía cargada</span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(_previewDataUrl) || (!string.IsNullOrWhiteSpace(_imagenUrl) && EsEdicion))
                        {
                            <button type="button"
                                    class="btn-quitar-foto"
                                    title="Quitar imagen"
                                    disabled="@_guardando"
                                    @onclick="QuitarImagenClickAsync">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                </svg>
                                <span>Quitar foto</span>
                            </button>
                        }
                    </div>

                    <!-- Dropzone / InputFile -->
                    <div class="dropzone-box text-center p-3 mb-3">
                        <label class="dropzone-label d-block cursor-pointer">
                            <div class="dropzone-icon-wrap mx-auto mb-2">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary" aria-hidden="true">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="17 8 12 3 7 8"></polyline>
                                    <line x1="12" y1="3" x2="12" y2="15"></line>
                                </svg>
                            </div>
                            <span class="d-block fw-semibold text-main">
                                @(string.IsNullOrWhiteSpace(_imagenUrl) && string.IsNullOrWhiteSpace(_previewDataUrl)
                                    ? "Seleccioná o arrastrá una foto"
                                    : "Hacé clic para cambiar la foto")
                            </span>
                            <span class="d-block text-muted small mt-1">
                                Formatos: JPG, PNG o WebP (hasta 8 MB)
                            </span>
                            <InputFile OnChange="HandleFileSelectedAsync"
                                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                       class="visually-hidden" />
                        </label>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_errorFoto))
                    {
                        <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3">
                            @_errorFoto
                        </div>
                    }

                    <!-- Consejo de fotografía -->
                    <div class="tip-box p-2.5 rounded-3 d-flex gap-2 align-items-start">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-warning shrink-0 mt-0.5" aria-hidden="true">
                            <circle cx="12" cy="12" r="5"></circle>
                            <line x1="12" y1="1" x2="12" y2="3"></line>
                            <line x1="12" y1="21" x2="12" y2="23"></line>
                            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                            <line x1="1" y1="12" x2="3" y2="12"></line>
                            <line x1="21" y1="12" x2="23" y2="12"></line>
                            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                        </svg>
                        <p class="small text-muted m-0">
                            <strong>Consejo de curaduría:</strong> Recomendamos fotos con luz natural sobre fondo neutro para destacar el color real y la textura de la prenda.
                        </p>
                    </div>
                </div>

                <!-- Card: Estado de Publicación -->
                <div class="form-card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-semibold text-main d-flex align-items-center gap-2">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary" aria-hidden="true">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <span>Producto Activo</span>
                        </span>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input switch-activo"
                                   type="checkbox"
                                   role="switch"
                                   id="switch-form-activo"
                                   @bind="_activo" />
                        </div>
                    </div>
                    <p class="small text-muted m-0">
                        Visible en el catálogo público para los clientes. Si se desactiva, no aparecerá en búsquedas ni en la tienda.
                    </p>
                </div>

                <!-- Card: Botones de Acción -->
                <div class="form-card p-4 d-flex flex-column gap-2">
                    <button type="button"
                            class="btn btn-primary w-100 py-2.5 d-inline-flex justify-content-center align-items-center gap-2 shadow-sm"
                            disabled="@_guardando"
                            @onclick="GuardarProductoAsync">
                        @if (_guardando)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>@(EsEdicion ? "Guardar cambios" : "Publicar producto")</span>
                        }
                    </button>

                    @if (EsEdicion)
                    {
                        <button type="button"
                                class="btn btn-outline-secondary w-100 py-2 d-inline-flex justify-content-center align-items-center gap-2"
                                disabled="@_guardando"
                                @onclick="AlternarEstadoDirectoAsync">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="10" y1="15" x2="10" y2="9"></line>
                                <line x1="14" y1="15" x2="14" y2="9"></line>
                            </svg>
                            <span>@(_activo ? "Pausar / Desactivar producto" : "Reactivar producto")</span>
                        </button>
                    }
                </div>
            </div>

            <!-- COLUMNA DERECHA: Datos y Atributos (7 cols) -->
            <div class="col-12 col-lg-7 d-flex flex-column gap-4">
                <div class="form-card p-4">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom border-soft">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary" aria-hidden="true">
                            <path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"></path>
                        </svg>
                        <h2 class="card-section-title font-serif m-0">Datos y detalles de la prenda</h2>
                    </div>

                    <div class="d-flex flex-column gap-3">
                        <!-- Nombre -->
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label for="prod-nombre" class="form-label mb-0">
                                    Nombre de la prenda <span class="text-danger">*</span>
                                </label>
                                <span class="small text-muted">@(_nombre.Length)/200 car.</span>
                            </div>
                            <input id="prod-nombre"
                                   type="text"
                                   class="form-control @(string.IsNullOrWhiteSpace(_nombre) && _validado ? "is-invalid" : "")"
                                   placeholder="Ej. Cárdigan tejido mostaza con botones de madera"
                                   maxlength="200"
                                   @bind="_nombre" />
                            @if (string.IsNullOrWhiteSpace(_nombre) && _validado)
                            {
                                <div class="invalid-feedback">El nombre es obligatorio.</div>
                            }
                        </div>

                        <!-- Descripción -->
                        <div>
                            <label for="prod-descripcion" class="form-label">Descripción</label>
                            <textarea id="prod-descripcion"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Contale a las familias sobre la textura, materialidad y ocasiones de uso..."
                                      @bind="_descripcion"></textarea>
                            <span class="small text-muted mt-1 d-block">
                                Detalles de la tela, abrigo y ocasión recomendada.
                            </span>
                        </div>

                        <!-- Categoría -->
                        <div>
                            <label for="prod-categoria" class="form-label">
                                Categoría <span class="text-danger">*</span>
                            </label>
                            <select id="prod-categoria"
                                    class="form-select @(_categoriaId <= 0 && _validado ? "is-invalid" : "")"
                                    @bind="_categoriaId">
                                <option value="0">Seleccioná una categoría...</option>
                                @foreach (var cat in _categorias)
                                {
                                    <option value="@cat.Id">@cat.Nombre</option>
                                }
                            </select>
                            @if (_categoriaId <= 0 && _validado)
                            {
                                <div class="invalid-feedback">Debés seleccionar una categoría.</div>
                            }
                        </div>

                        <!-- Fila: Precio y Stock -->
                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <label for="prod-precio" class="form-label">
                                    Precio al público <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input id="prod-precio"
                                           type="number"
                                           step="0.01"
                                           min="0.01"
                                           class="form-control @(_precio <= 0 && _validado ? "is-invalid" : "")"
                                           placeholder="4500.00"
                                           @bind="_precio" />
                                    @if (_precio <= 0 && _validado)
                                    {
                                        <div class="invalid-feedback">El precio debe ser mayor a 0.</div>
                                    }
                                </div>
                                <span class="small text-muted mt-1 d-block">En pesos argentinos ($)</span>
                            </div>

                            <div class="col-12 col-sm-6">
                                <label for="prod-stock" class="form-label">
                                    Stock disponible <span class="text-danger">*</span>
                                </label>
                                <input id="prod-stock"
                                       type="number"
                                       min="0"
                                       class="form-control @(_stockDisponible < 0 && _validado ? "is-invalid" : "")"
                                       placeholder="1"
                                       @bind="_stockDisponible" />
                                @if (_stockDisponible < 0 && _validado)
                                {
                                    <div class="invalid-feedback">El stock no puede ser negativo.</div>
                                }
                                <span class="small text-muted mt-1 d-block">Piezas disponibles en local o depósito</span>
                            </div>
                        </div>

                        <!-- Fila: Talle y Estado de la Prenda -->
                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <label for="prod-talle" class="form-label">
                                    Talle infantil <span class="text-danger">*</span>
                                </label>
                                <select id="prod-talle"
                                        class="form-select @(string.IsNullOrWhiteSpace(_talle) && _validado ? "is-invalid" : "")"
                                        @bind="_talle">
                                    <option value="">Seleccioná un talle...</option>
                                    @foreach (var valor in TalleConstantes.Valores)
                                    {
                                        <option value="@valor">@valor</option>
                                    }
                                </select>
                                @if (string.IsNullOrWhiteSpace(_talle) && _validado)
                                {
                                    <div class="invalid-feedback">El talle es obligatorio.</div>
                                }
                            </div>

                            <div class="col-12 col-sm-6">
                                <label for="prod-estado" class="form-label">
                                    Estado de la prenda <span class="text-danger">*</span>
                                </label>
                                <select id="prod-estado"
                                        class="form-select @(!_estadoPrenda.HasValue && _validado ? "is-invalid" : "")"
                                        @bind="_estadoPrenda">
                                    <option value="">Seleccioná el estado...</option>
                                    @foreach (EstadoPrenda est in Enum.GetValues<EstadoPrenda>())
                                    {
                                        <option value="@est">@EstadoPrendaHelper.ObtenerTexto(est)</option>
                                    }
                                </select>
                                @if (!_estadoPrenda.HasValue && _validado)
                                {
                                    <div class="invalid-feedback">El estado de la prenda es obligatorio.</div>
                                }
                            </div>
                        </div>

                        <!-- Observaciones -->
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label for="prod-observaciones" class="form-label mb-0">
                                    Observaciones o detalles
                                </label>
                                <span class="badge-card-pill">Uso interno / local</span>
                            </div>
                            <textarea id="prod-observaciones"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Ej. Pequeño desgaste en rodilla izquierda, botón de repuesto incluido, percha #4..."
                                      maxlength="300"
                                      @bind="_observaciones"></textarea>
                            <span class="small text-muted mt-1 d-block">
                                Detalles de control de calidad, percha o manchitas para informar con honestidad a la familia.
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private bool EsEdicion => Id.HasValue && Id.Value > 0;

    private ProductoAdminDto? _productoCargado;
    private List<CategoriaDto> _categorias = new();
    private bool _cargandoInicial = true;
    private bool _guardando = false;
    private bool _validado = false;

    // Campos del formulario
    private string _nombre = string.Empty;
    private string _descripcion = string.Empty;
    private int _categoriaId = 0;
    private decimal _precio = 0m;
    private int _stockDisponible = 1;
    private string _talle = TalleConstantes.TalleUnico;
    private EstadoPrenda? _estadoPrenda = EstadoPrenda.MuyBueno;
    private string? _observaciones;
    private bool _activo = true;
    private byte[] _rowVersion = Array.Empty<byte>();

    // Manejo de imagen
    private string? _imagenUrl;
    private string? _previewDataUrl;
    private byte[]? _archivoBytes;
    private string _archivoNombre = string.Empty;
    private string? _errorFoto;

    // Avisos
    private bool _errorConcurrencia;
    private string? _mensajeError;
    private string? _mensajeExito;

    private const long MaxTamanoFotoBytes = 8 * 1024 * 1024; // 8 MB

    protected override async Task OnParametersSetAsync()
    {
        await CargarInicialAsync();
    }

    private async Task CargarInicialAsync()
    {
        _cargandoInicial = true;
        _errorConcurrencia = false;
        _mensajeError = null;
        _mensajeExito = null;
        _validado = false;

        try
        {
            _categorias = await AdminCatalogoServicio.ObtenerCategoriasAsync();

            if (EsEdicion)
            {
                await CargarProductoExistenteAsync(Id!.Value);
            }
            else
            {
                // Reset valores por defecto en creación
                _nombre = string.Empty;
                _descripcion = string.Empty;
                _categoriaId = _categorias.FirstOrDefault()?.Id ?? 0;
                _precio = 0m;
                _stockDisponible = 1;
                _talle = TalleConstantes.TalleUnico;
                _estadoPrenda = EstadoPrenda.MuyBueno;
                _observaciones = null;
                _activo = true;
                _imagenUrl = null;
                _previewDataUrl = null;
                _archivoBytes = null;
                _rowVersion = Array.Empty<byte>();
            }
        }
        catch (KeyNotFoundException)
        {
            _mensajeError = "El producto no existe o fue eliminado.";
        }
        catch (Exception ex)
        {
            _mensajeError = $"Error al cargar los datos: {ex.Message}";
        }
        finally
        {
            _cargandoInicial = false;
        }
    }

    private async Task CargarProductoExistenteAsync(int id)
    {
        var producto = await AdminCatalogoServicio.ObtenerProductoAsync(id);
        _productoCargado = producto;

        _nombre = producto.Nombre;
        _descripcion = producto.Descripcion;
        _categoriaId = producto.CategoriaId;
        _precio = producto.Precio;
        _stockDisponible = producto.StockDisponible;
        _talle = producto.Talle;
        _observaciones = producto.Observaciones;
        _activo = producto.Activo;
        _imagenUrl = producto.ImagenUrl;
        _previewDataUrl = null;
        _archivoBytes = null;
        _rowVersion = producto.RowVersion;

        if (Enum.TryParse<EstadoPrenda>(producto.Estado, true, out var estadoParsed))
        {
            _estadoPrenda = estadoParsed;
        }
        else
        {
            _estadoPrenda = EstadoPrenda.MuyBueno;
        }
    }

    private async Task RecargarProductoAsync()
    {
        if (EsEdicion)
        {
            _errorConcurrencia = false;
            _mensajeError = null;
            _cargandoInicial = true;
            try
            {
                await CargarProductoExistenteAsync(Id!.Value);
                _mensajeExito = "Datos recargados exitosamente.";
            }
            catch (Exception ex)
            {
                _mensajeError = $"Error al recargar: {ex.Message}";
            }
            finally
            {
                _cargandoInicial = false;
            }
        }
    }

    private async Task HandleFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _errorFoto = null;
        var archivo = e.File;
        if (archivo == null) return;

        // Validar tamaño
        if (archivo.Size > MaxTamanoFotoBytes)
        {
            _errorFoto = "La imagen no puede superar los 8 MB.";
            return;
        }

        // Validar extensión
        var ext = Path.GetExtension(archivo.Name).ToLowerInvariant();
        if (ext != ".jpg" && ext != ".jpeg" && ext != ".png" && ext != ".webp")
        {
            _errorFoto = "Solo se permiten imágenes en formato JPG, PNG o WebP.";
            return;
        }

        try
        {
            var buffer = new byte[archivo.Size];
            using var stream = archivo.OpenReadStream(maxAllowedSize: MaxTamanoFotoBytes);
            await stream.ReadExactlyAsync(buffer);

            _archivoBytes = buffer;
            _archivoNombre = archivo.Name;
            _previewDataUrl = $"data:{archivo.ContentType};base64,{Convert.ToBase64String(buffer)}";
        }
        catch (Exception ex)
        {
            _errorFoto = $"Error al procesar la imagen seleccionada: {ex.Message}";
            _archivoBytes = null;
            _previewDataUrl = null;
        }
    }

    private async Task QuitarImagenClickAsync()
    {
        _errorFoto = null;

        // Si había una previsualización de archivo local no guardado, simplemente limpiarla
        if (!string.IsNullOrWhiteSpace(_previewDataUrl))
        {
            _previewDataUrl = null;
            _archivoBytes = null;
            _archivoNombre = string.Empty;
            return;
        }

        // Si es edición y tiene imagen en el servidor, llamar al servicio
        if (EsEdicion && !string.IsNullOrWhiteSpace(_imagenUrl))
        {
            try
            {
                _guardando = true;
                var actualizado = await AdminCatalogoServicio.QuitarImagenAsync(Id!.Value, _rowVersion);
                _rowVersion = actualizado.RowVersion;
                _imagenUrl = null;
                _mensajeExito = "Fotografía eliminada.";
            }
            catch (ProductoModificadoException)
            {
                _errorConcurrencia = true;
                _mensajeError = "El producto fue modificado, recargá";
            }
            catch (Exception ex)
            {
                _mensajeError = $"Error al quitar imagen: {ex.Message}";
            }
            finally
            {
                _guardando = false;
            }
        }
    }

    private async Task GuardarProductoAsync()
    {
        _validado = true;
        _mensajeError = null;
        _mensajeExito = null;
        _errorConcurrencia = false;

        // Validaciones en cliente
        if (string.IsNullOrWhiteSpace(_nombre))
        {
            _mensajeError = "Por favor ingresá el nombre de la prenda.";
            return;
        }

        if (_categoriaId <= 0)
        {
            _mensajeError = "Por favor seleccioná una categoría.";
            return;
        }

        if (_precio <= 0)
        {
            _mensajeError = "El precio debe ser mayor a cero.";
            return;
        }

        if (_stockDisponible < 0)
        {
            _mensajeError = "El stock disponible no puede ser negativo.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_talle) || !TalleConstantes.EsValido(_talle))
        {
            _mensajeError = "Por favor seleccioná un talle válido.";
            return;
        }

        if (!_estadoPrenda.HasValue)
        {
            _mensajeError = "Por favor seleccioná el estado de la prenda.";
            return;
        }

        _guardando = true;

        try
        {
            if (EsEdicion)
            {
                // Modificar producto existente
                var request = new ModificarProductoRequest
                {
                    Nombre = _nombre.Trim(),
                    Descripcion = _descripcion?.Trim() ?? string.Empty,
                    Precio = _precio,
                    StockDisponible = _stockDisponible,
                    CategoriaId = _categoriaId,
                    Talle = _talle.Trim(),
                    Estado = _estadoPrenda.Value,
                    Observaciones = string.IsNullOrWhiteSpace(_observaciones) ? null : _observaciones.Trim(),
                    RowVersion = _rowVersion
                };

                var productoActualizado = await AdminCatalogoServicio.ModificarProductoAsync(Id!.Value, request);
                _rowVersion = productoActualizado.RowVersion;

                // Si cambió el estado activo
                if (productoActualizado.Activo != _activo)
                {
                    if (_activo)
                    {
                        var act = await AdminCatalogoServicio.ActivarProductoAsync(Id!.Value, _rowVersion);
                        _rowVersion = act.RowVersion;
                    }
                    else
                    {
                        await AdminCatalogoServicio.DesactivarProductoAsync(Id!.Value, _rowVersion);
                        var act = await AdminCatalogoServicio.ObtenerProductoAsync(Id!.Value);
                        _rowVersion = act.RowVersion;
                    }
                }

                // Si seleccionó una nueva foto para subir
                if (_archivoBytes != null)
                {
                    using var stream = new MemoryStream(_archivoBytes);
                    var prodConFoto = await AdminCatalogoServicio.AsignarImagenAsync(
                        Id!.Value, stream, _archivoBytes.Length, _archivoNombre, _rowVersion);

                    _rowVersion = prodConFoto.RowVersion;
                    _imagenUrl = prodConFoto.ImagenUrl;
                    _previewDataUrl = null;
                    _archivoBytes = null;
                }

                _mensajeExito = "Producto guardado exitosamente.";
                _productoCargado = await AdminCatalogoServicio.ObtenerProductoAsync(Id!.Value);
            }
            else
            {
                // Crear producto nuevo
                var request = new CrearProductoRequest
                {
                    Nombre = _nombre.Trim(),
                    Descripcion = _descripcion?.Trim() ?? string.Empty,
                    Precio = _precio,
                    StockDisponible = _stockDisponible,
                    CategoriaId = _categoriaId,
                    Talle = _talle.Trim(),
                    Estado = _estadoPrenda.Value,
                    Observaciones = string.IsNullOrWhiteSpace(_observaciones) ? null : _observaciones.Trim()
                };

                var creado = await AdminCatalogoServicio.CrearProductoAsync(request);
                var rowVersionActual = creado.RowVersion;

                // Si el usuario desmarcó 'Activo' en creación (crear nace activo por default)
                if (!_activo)
                {
                    await AdminCatalogoServicio.DesactivarProductoAsync(creado.Id, rowVersionActual);
                    var act = await AdminCatalogoServicio.ObtenerProductoAsync(creado.Id);
                    rowVersionActual = act.RowVersion;
                }

                // Subir foto si seleccionó una
                if (_archivoBytes != null)
                {
                    using var stream = new MemoryStream(_archivoBytes);
                    await AdminCatalogoServicio.AsignarImagenAsync(
                        creado.Id, stream, _archivoBytes.Length, _archivoNombre, rowVersionActual);
                }

                Navigation.NavigateTo("/admin/productos");
            }
        }
        catch (ProductoModificadoException)
        {
            _errorConcurrencia = true;
            _mensajeError = "El producto fue modificado, recargá";
        }
        catch (Exception ex)
        {
            _mensajeError = $"Error al guardar el producto: {ex.Message}";
        }
        finally
        {
            _guardando = false;
        }
    }

    private async Task AlternarEstadoDirectoAsync()
    {
        if (!EsEdicion) return;

        _guardando = true;
        _mensajeError = null;
        _mensajeExito = null;
        _errorConcurrencia = false;

        try
        {
            if (_activo)
            {
                await AdminCatalogoServicio.DesactivarProductoAsync(Id!.Value, _rowVersion);
                var act = await AdminCatalogoServicio.ObtenerProductoAsync(Id!.Value);
                _rowVersion = act.RowVersion;
                _activo = false;
                _mensajeExito = "Producto desactivado.";
            }
            else
            {
                var act = await AdminCatalogoServicio.ActivarProductoAsync(Id!.Value, _rowVersion);
                _rowVersion = act.RowVersion;
                _activo = true;
                _mensajeExito = "Producto activado.";
            }
        }
        catch (ProductoModificadoException)
        {
            _errorConcurrencia = true;
            _mensajeError = "El producto fue modificado, recargá";
        }
        catch (Exception ex)
        {
            _mensajeError = $"Error al cambiar estado: {ex.Message}";
        }
        finally
        {
            _guardando = false;
        }
    }
}
