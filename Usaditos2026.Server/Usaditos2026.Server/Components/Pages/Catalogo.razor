@page "/catalogo"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Globalization
@using System.Security.Claims
@using Usaditos2026.Servicios.Interfaces
@using Usaditos2026.Shared.DTOs
@using Usaditos2026.Shared.Excepciones
@inject ICatalogoServicio CatalogoServicio
@inject ICarritoServicio CarritoServicio
@inject NavigationManager Navigation

<PageTitle>Catálogo</PageTitle>

<h1 class="catalogo-titulo mb-4">Catálogo</h1>

@if (!string.IsNullOrWhiteSpace(_mensajeExito))
{
    <div class="alert alert-success catalogo-alert" role="alert">
        @_mensajeExito
        <a class="alert-link ms-2" href="/carrito">Ver carrito</a>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_mensajeError))
{
    <div class="alert @_claseMensajeError catalogo-alert" role="alert">@_mensajeError</div>
}

@if (_cargando)
{
    <p class="catalogo-estado">Cargando productos...</p>
}
else if (_productos.Count == 0)
{
    <p class="catalogo-estado">No hay productos disponibles.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        @foreach (var producto in _productos)
        {
            <div class="col">
                <div class="card h-100 card-producto">
                    <!-- Cabecera ilustrativa de altura fija con SVG decorativo -->
                    <div class="card-img-placeholder d-flex align-items-center justify-content-center" aria-hidden="true">
                        <svg class="placeholder-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 3a2 2 0 0 1 2 2c0 1.1-.9 2-2 2a2 2 0 0 1-2-2 2 2 0 0 1 2-2z" />
                            <path d="M12 7v2" />
                            <path d="M2.5 16.5 12 9l9.5 7.5a1.5 1.5 0 0 1-.9 2.5H3.4a1.5 1.5 0 0 1-.9-2.5z" />
                        </svg>
                    </div>

                    <div class="card-body d-flex flex-column">
                        <div class="mb-2">
                            <span class="badge badge-categoria text-break">@producto.NombreCategoria</span>
                        </div>

                        <h5 class="card-title text-break mb-2">@producto.Nombre</h5>
                        <p class="card-text text-muted text-break mb-3">@producto.Descripcion</p>

                        <div class="mt-auto">
                            <div class="mb-2">
                                <span class="precio-producto">@producto.Precio.ToString("C", new CultureInfo("es-AR"))</span>
                            </div>

                            <div class="mb-3 stock-info">
                                <strong>Stock: </strong>
                                @if (producto.StockDisponible == 0)
                                {
                                    <span class="badge badge-stock-cero">Sin stock</span>
                                }
                                else if (producto.StockDisponible == 1)
                                {
                                    <span class="badge badge-stock-uno">¡Última unidad!</span>
                                }
                                else
                                {
                                    <span class="stock-disponible">@producto.StockDisponible disponibles</span>
                                }
                            </div>

                            <button type="button" class="btn btn-primary w-100 btn-agregar" aria-label="Agregar @producto.Nombre al carrito" @onclick="() => AgregarAlCarritoAsync(producto)">
                                Agregar al carrito
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private readonly List<ProductoDto> _productos = new();
    private int? _clienteId;
    private bool _cargando = true;
    private string? _mensajeExito;
    private string? _mensajeError;
    private string _claseMensajeError = "alert-warning";

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is null)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        var authenticationState = await AuthenticationStateTask;
        var idClaim = authenticationState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!int.TryParse(idClaim, out var clienteId))
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        _clienteId = clienteId;

        try
        {
            var productos = await CatalogoServicio.ObtenerProductosAsync();
            _productos.Clear();
            _productos.AddRange(productos);
        }
        catch (Exception)
        {
            _mensajeError = "No se pudieron cargar los productos. Intentá de nuevo.";
            _claseMensajeError = "alert-danger";
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task AgregarAlCarritoAsync(ProductoDto producto)
    {
        if (_clienteId is null)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        _mensajeExito = null;
        _mensajeError = null;
        _claseMensajeError = "alert-warning";

        try
        {
            var carritoActualizado = await CarritoServicio.AgregarProductoAsync(
                _clienteId.Value,
                new AgregarItemCarritoRequest
                {
                    ProductoId = producto.Id,
                    Cantidad = 1
                });

            var unidades = carritoActualizado.Items.Sum(i => i.Cantidad);
            var total = carritoActualizado.Total.ToString("C", new CultureInfo("es-AR"));
            _mensajeExito = $"Agregaste '{producto.Nombre}' al carrito. Tu carrito: {unidades} unidad(es), total {total}.";
        }
        catch (StockInsuficienteException ex)
        {
            _mensajeError = ex.Message;
        }
        catch (LimiteUnidadesException ex)
        {
            _mensajeError = ex.Message;
        }
        catch (Exception)
        {
            _mensajeError = "No se pudo agregar el producto. Intentá de nuevo.";
            _claseMensajeError = "alert-danger";
        }
    }
}
