@page "/pedidos/{id:int}/confirmado"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Globalization
@using System.Security.Claims
@using Usaditos2026.Servicios.Interfaces
@using Usaditos2026.Shared.Constantes
@using Usaditos2026.Shared.DTOs
@using Usaditos2026.Shared.Utilidades
@inject IPedidoServicio PedidoServicio
@inject ITiendaServicio TiendaServicio
@inject ICatalogoServicio CatalogoServicio
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>¡Pedido confirmado! | Usaditos Hernando</PageTitle>

<div class="confirmado-page">
    @if (_cargando)
    {
        <div class="confirmado-loading" role="status" aria-live="polite">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando pedido...</span>
            </div>
            <p class="confirmado-loading-text mt-3">Buscando los datos de tu compra...</p>
        </div>
    }
    else if (_noEncontrado || _pedido is null)
    {
        <!-- Estado: Pedido no encontrado -->
        <section class="card-no-encontrado-wrapper" aria-label="Pedido no encontrado">
            <div class="card-no-encontrado-box">
                <div class="no-encontrado-icon-circle" aria-hidden="true">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                </div>

                <h1 class="no-encontrado-titulo font-serif">Pedido no encontrado</h1>
                <p class="no-encontrado-descripcion">
                    No pudimos encontrar los detalles del pedido solicitado o no pertenece a tu cuenta de cliente.
                </p>

                <div class="d-flex flex-wrap align-items-center justify-content-center gap-2 mt-2">
                    <a href="/pedidos" class="btn btn-primary">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <path d="M16 10a4 4 0 0 1-8 0"></path>
                        </svg>
                        <span>Ver mis pedidos</span>
                    </a>
                    <a href="/catalogo" class="btn btn-outline-primary">
                        <span>Ir al catálogo</span>
                    </a>
                </div>
            </div>
        </section>
    }
    else
    {
        <!-- Partículas festivas sutiles de confeti en naranja y amarillo -->
        <div class="confetti-container" aria-hidden="true">
            <div class="confetti-particle p1"></div>
            <div class="confetti-particle p2"></div>
            <div class="confetti-particle p3"></div>
            <div class="confetti-particle p4"></div>
            <div class="confetti-particle p5"></div>
            <div class="confetti-particle p6"></div>
        </div>

        <div class="confirmado-content-wrap">
            <!-- 1. ENCABEZADO DE ÉXITO CENTRADO -->
            <header class="confirmado-header-centrado">
                <div class="check-glow-container">
                    <div class="check-circle-big" aria-hidden="true">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>

                        <!-- Micro insignias festivas -->
                        <span class="micro-badge badge-celebrate" title="¡Felicitaciones!">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                            </svg>
                        </span>
                        <span class="micro-badge badge-leaf" title="Moda circular">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 3a2 2 0 0 1 2 2c0 1.1-.9 2-2 2a2 2 0 0 1-2-2 2 2 0 0 1 2-2z" />
                                <path d="M12 7v2" />
                                <path d="M2.5 16.5 12 9l9.5 7.5a1.5 1.5 0 0 1-.9 2.5H3.4a1.5 1.5 0 0 1-.9-2.5z" />
                            </svg>
                        </span>
                    </div>
                </div>

                <div class="badge-operacion-exitosa">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>¡Operación registrada con éxito!</span>
                </div>

                <h1 class="confirmado-titulo font-serif">¡Pedido confirmado!</h1>
                <p class="confirmado-subtitulo">Gracias por tu compra. Esto es lo que sigue.</p>
            </header>

            <!-- 2. TARJETA RESUMEN DEL PEDIDO -->
            <section class="pedido-card-resumen" aria-label="Detalle del pedido confirmado">
                <!-- Barra superior de la tarjeta -->
                <div class="pedido-card-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="pedido-receipt-icon" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <line x1="16" y1="13" x2="8" y2="13"></line>
                                <line x1="16" y1="17" x2="8" y2="17"></line>
                                <polyline points="10 9 9 9 8 9"></polyline>
                            </svg>
                        </div>
                        <div>
                            <div class="d-flex align-items-baseline gap-2 flex-wrap">
                                <span class="pedido-id-text font-serif">Pedido #@_pedido.Id</span>
                                <span class="text-muted small">·</span>
                                <span class="pedido-fecha-text">@FormatearFechaLocal(_pedido.Fecha)</span>
                            </div>
                            <span class="pedido-ubicacion-text">Hernando, Córdoba · Venta de moda circular</span>
                        </div>
                    </div>

                    <!-- Chips de Estado -->
                    <div class="pedido-chips-group">
                        <!-- Chip de estado "Confirmado" -->
                        <span class="chip-estado confirmado">
                            <span class="chip-pulse-dot" aria-hidden="true"></span>
                            <span>@_pedido.Estado</span>
                        </span>
                        <!-- Chip de pago "Pago pendiente" -->
                        <span class="chip-estado pago-pendiente">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            <span>@(_pedido.EstadoPago == EstadoPago.Pendiente ? "Pago pendiente" : "Pagado")</span>
                        </span>
                    </div>
                </div>

                <!-- Lista de Prendas del Pedido -->
                <div class="pedido-items-lista">
                    @foreach (var item in _pedido.Items)
                    {
                        var tieneImagen = _imagenesMap.TryGetValue(item.ProductoId, out var imagenUrl) && !string.IsNullOrWhiteSpace(imagenUrl);

                        <article class="pedido-item-row">
                            <div class="pedido-item-thumb">
                                @if (tieneImagen)
                                {
                                    <img src="@imagenUrl" alt="@item.NombreProducto" />
                                }
                                else
                                {
                                    <div class="pedido-thumb-placeholder">
                                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M2.5 16.5 12 9l9.5 7.5a1.5 1.5 0 0 1-.9 2.5H3.4a1.5 1.5 0 0 1-.9-2.5z" />
                                        </svg>
                                    </div>
                                }
                            </div>
                            <div class="pedido-item-info">
                                <div class="pedido-item-meta-badges">
                                    <span class="badge-item-talle">@TalleTextoHelper.Formatear(null)</span>
                                </div>
                                <h3 class="pedido-item-titulo">@item.NombreProducto</h3>
                                <p class="pedido-item-cantidad mb-0">
                                    @item.Cantidad @(item.Cantidad == 1 ? "unidad seleccionada" : "unidades seleccionadas")
                                </p>
                            </div>
                            <div class="pedido-item-precios text-end">
                                <span class="pedido-item-unitario">@item.Cantidad × @item.PrecioUnitario.ToString("C", _culturaAr)</span>
                                <span class="pedido-item-subtotal font-serif">@item.Subtotal.ToString("C", _culturaAr)</span>
                            </div>
                        </article>
                    }
                </div>

                <!-- Barra de Total Final -->
                <div class="pedido-total-bar">
                    <div class="pedido-total-izq">
                        <div class="d-flex align-items-center gap-1 text-muted small mb-1">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary" aria-hidden="true">
                                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                            </svg>
                            <span>Estás ahorrando ~65% respecto al precio de prendas nuevas en retail</span>
                        </div>
                        <div class="text-muted small">
                            Subtotal de @_pedido.Items.Sum(i => i.Cantidad) @(_pedido.Items.Sum(i => i.Cantidad) == 1 ? "prenda seleccionada" : "prendas seleccionadas"):
                            <strong class="text-dark">@_pedido.Total.ToString("C", _culturaAr)</strong>
                        </div>
                    </div>
                    <div class="pedido-total-der text-end">
                        <span class="total-der-label">Total a abonar</span>
                        <span class="total-der-monto font-serif">@_pedido.Total.ToString("C", _culturaAr)</span>
                    </div>
                </div>
            </section>

            <!-- 3. BLOQUE DINÁMICO 'QUÉ SIGUE' -->
            <section class="bloque-que-sigue" aria-label="Instrucciones del pedido">
                <div class="bloque-header mb-3">
                    <span class="bloque-header-tag">Instrucciones del Pedido</span>
                    <h2 class="bloque-header-title font-serif">¿Qué sigue?</h2>
                    <p class="bloque-header-sub">Revisá las indicaciones según cómo elegiste abonar y recibir tus prendas:</p>
                </div>

                <div class="instrucciones-grid">
                    <!-- Instrucción 1: Según Método de Pago -->
                    @if (_pedido.MetodoPago == MetodoPago.Transferencia)
                    {
                        <div class="instruccion-card">
                            <div class="instruccion-card-header">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="instruccion-avatar primary">
                                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <h3 class="instruccion-titulo">Pago por Transferencia Bancaria</h3>
                                        <span class="instruccion-subtitulo">Realizá la transferencia desde tu homebanking o billetera virtual</span>
                                    </div>
                                </div>
                                <span class="badge-comprobante-pendiente">Pendiente de comprobante</span>
                            </div>

                            <div class="transfer-info-grid">
                                <div class="transfer-grid-box">
                                    <span class="transfer-box-label">Monto a transferir</span>
                                    <span class="transfer-box-value font-serif text-primary">@_pedido.Total.ToString("C", _culturaAr)</span>
                                </div>
                                <div class="transfer-grid-box d-flex align-items-center justify-content-between">
                                    <div>
                                        <span class="transfer-box-label">Alias de CBU / CVU</span>
                                        <span class="transfer-box-value font-mono text-primary fw-bold">@(!string.IsNullOrWhiteSpace(_tiendaInfo?.AliasTransferencia) ? _tiendaInfo.AliasTransferencia : "Consultá este dato con el local")</span>
                                    </div>
                                    <button type="button"
                                            class="btn-copy-alias-mini @(_aliasCopiado ? "copied" : "")"
                                            @onclick="CopiarAliasAsync"
                                            aria-label="Copiar alias bancario">
                                        @if (_aliasCopiado)
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                            <span>¡Copiado!</span>
                                        }
                                        else
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                                            </svg>
                                            <span>Copiar alias</span>
                                        }
                                    </button>
                                </div>
                                <div class="transfer-grid-box">
                                    <span class="transfer-box-label">Titular de la cuenta</span>
                                    <span class="transfer-box-value text-dark fw-bold">@(!string.IsNullOrWhiteSpace(_tiendaInfo?.TitularTransferencia) ? _tiendaInfo.TitularTransferencia : "Consultá este dato con el local")</span>
                                </div>
                            </div>

                            <div class="aviso-coordinacion">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-orange" aria-hidden="true">
                                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                </svg>
                                <p class="mb-0">
                                    <strong>Coordinamos con vos por el teléfono que dejaste.</strong>
                                </p>
                            </div>
                        </div>
                    }
                    else if (_pedido.MetodoPago == MetodoPago.Efectivo)
                    {
                        <div class="instruccion-card">
                            <div class="instruccion-card-header">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="instruccion-avatar orange">
                                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="12" y1="1" x2="12" y2="23"></line>
                                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <h3 class="instruccion-titulo">Pago en Efectivo</h3>
                                        <span class="instruccion-subtitulo">@(_pedido.TipoEntrega == TipoEntrega.Envio ? "Pagás en efectivo al recibir" : "Pagás en el local al retirar")</span>
                                    </div>
                                </div>
                                <span class="badge-tag-efectivo">@(_pedido.TipoEntrega == TipoEntrega.Envio ? "Al recibir" : "Al retirar")</span>
                            </div>

                            <div class="pago-efectivo-box">
                                <p class="mb-2">
                                    Tus prendas quedan reservadas a tu nombre durante <strong>48 horas hábiles</strong>.
                                </p>
                                <div class="info-recordatorio-pedido">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary" aria-hidden="true">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="12" y1="16" x2="12" y2="12"></line>
                                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                    </svg>
                                    @if (_pedido.TipoEntrega == TipoEntrega.Envio)
                                    {
                                        <span>Recordá tener el monto exacto preparado para cuando llegue tu <strong>Pedido #@_pedido.Id</strong>.</span>
                                    }
                                    else
                                    {
                                        <span>Recordá mencionar tu <strong>Pedido #@_pedido.Id</strong> al acercarte al mostrador en Hernando.</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Instrucción 2: Según Tipo de Entrega -->
                    @if (_pedido.TipoEntrega == TipoEntrega.Retiro)
                    {
                        <div class="instruccion-card">
                            <div class="instruccion-card-header">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="instruccion-avatar primary">
                                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                        </svg>
                                    </div>
                                    <div>
                                        <h3 class="instruccion-titulo">Retiro en el local</h3>
                                        <span class="instruccion-subtitulo">Boutique Usaditos Hernando · Córdoba</span>
                                    </div>
                                </div>
                                <span class="badge-punto-oficial">Punto de retiro oficial</span>
                            </div>

                            <div class="retiro-info-grid">
                                <div class="retiro-grid-box">
                                    <div class="d-flex align-items-start gap-2">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1" aria-hidden="true">
                                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                            <circle cx="12" cy="10" r="3"></circle>
                                        </svg>
                                        <div>
                                            <span class="transfer-box-label">Dirección del local</span>
                                            <p class="fw-bold mb-0 text-dark">@(!string.IsNullOrWhiteSpace(_tiendaInfo?.Direccion) ? _tiendaInfo.Direccion : "Consultá este dato con el local")</p>
                                            <span class="text-muted small">Hernando, Córdoba (CP 5929)</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="retiro-grid-box">
                                    <div class="d-flex align-items-start gap-2">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1" aria-hidden="true">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 16 14"></polyline>
                                        </svg>
                                        <div>
                                            <span class="transfer-box-label">Horarios de atención</span>
                                            <p class="fw-bold mb-0 text-dark">@(!string.IsNullOrWhiteSpace(_tiendaInfo?.Horario) ? _tiendaInfo.Horario : "Consultá este dato con el local")</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="aviso-retiro-box">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary" aria-hidden="true">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                                </svg>
                                <p class="mb-0">
                                    <strong>Coordinamos con vos por el teléfono que dejaste</strong> apenas tu bolsita esté lista para retirar. No hace falta que vayas antes de recibir el mensaje.
                                </p>
                            </div>
                        </div>
                    }
                    else if (_pedido.TipoEntrega == TipoEntrega.Envio)
                    {
                        <div class="instruccion-card">
                            <div class="instruccion-card-header">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="instruccion-avatar orange">
                                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="1" y="3" width="15" height="13"></rect>
                                            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                                            <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                            <circle cx="18.5" cy="18.5" r="2.5"></circle>
                                        </svg>
                                    </div>
                                    <div>
                                        <h3 class="instruccion-titulo">Envío a domicilio</h3>
                                        <span class="instruccion-subtitulo">Coordinación directa de cadetería para tu comodidad</span>
                                    </div>
                                </div>
                                <span class="badge-destino-registrado">Destino registrado</span>
                            </div>

                            <div class="envio-direccion-box mb-3">
                                <div class="d-flex align-items-start gap-2">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-1" aria-hidden="true">
                                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                        <circle cx="12" cy="10" r="3"></circle>
                                    </svg>
                                    <div>
                                        <span class="transfer-box-label">Dirección ingresada para la entrega</span>
                                        <p class="fw-bold mb-0 text-dark fs-5">@_pedido.DireccionEnvio</p>
                                    </div>
                                </div>
                            </div>

                            <div class="aviso-retiro-box">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-orange" aria-hidden="true">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                </svg>
                                <p class="mb-0">
                                    Coordinación por <strong>cadetería local o encomienda</strong>. Nos comunicaremos con vos al <strong>@_pedido.TelefonoContacto</strong> para coordinar el día y horario aproximado de llegada a tu domicilio.
                                </p>
                            </div>
                        </div>
                    }
                </div>
            </section>

            <!-- 4. BOTONES DE ACCIÓN CENTRADOS -->
            <div class="confirmado-botones-accion">
