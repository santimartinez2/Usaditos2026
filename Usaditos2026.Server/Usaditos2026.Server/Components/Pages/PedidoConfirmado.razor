@code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private PedidoDto? _pedido;
    private TiendaInfoDto? _tiendaInfo;
    private Dictionary<int, string?> _imagenesMap = new();

    private bool _cargando = true;
    private bool _noEncontrado;
    private bool _aliasCopiado;

    private readonly CultureInfo _culturaAr = new("es-AR");

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is null)
        {
            Navigation.NavigateTo($"/login?returnUrl=/pedidos/{Id}/confirmado", forceLoad: true);
            return;
        }

        var authenticationState = await AuthenticationStateTask;
        var idClaim = authenticationState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!int.TryParse(idClaim, out var clienteId))
        {
            Navigation.NavigateTo($"/login?returnUrl=/pedidos/{Id}/confirmado", forceLoad: true);
            return;
        }

        try
        {
            _tiendaInfo = TiendaServicio.ObtenerInfo();
            _pedido = await PedidoServicio.ObtenerPedidoAsync(clienteId, Id);
            await CargarImagenesAsync();
        }
        catch (KeyNotFoundException)
        {
            _noEncontrado = true;
        }
        catch (UnauthorizedAccessException)
        {
            _noEncontrado = true;
        }
        catch (Exception)
        {
            _noEncontrado = true;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task CargarImagenesAsync()
    {
        if (_pedido is null || _pedido.Items.Count == 0)
            return;

        try
        {
            var ids = _pedido.Items.Select(i => i.ProductoId).Distinct();
            _imagenesMap = await CatalogoServicio.ObtenerImagenesAsync(ids);
        }
        catch
        {
            _imagenesMap = new();
        }
    }

    private string FormatearFechaLocal(DateTime fechaUtc)
    {
        var zonaId = !string.IsNullOrWhiteSpace(_tiendaInfo?.ZonaHoraria)
            ? _tiendaInfo.ZonaHoraria
            : FechaHelper.ZonaPorDefecto;

        var fechaLocal = FechaHelper.UtcALocal(fechaUtc, zonaId);
        return fechaLocal.ToString("d 'de' MMMM 'de' yyyy, HH:mm", _culturaAr) + " hs";
    }

    private async Task CopiarAliasAsync()
    {
        if (string.IsNullOrWhiteSpace(_tiendaInfo?.AliasTransferencia))
        {
            return;
        }

        var alias = _tiendaInfo.AliasTransferencia;

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", alias);
            _aliasCopiado = true;
            StateHasChanged();
            await Task.Delay(2500);
            _aliasCopiado = false;
            StateHasChanged();
        }
        catch
        {
            // Portapapeles no disponible
        }
    }
}
