@inherits LayoutComponentBase

<div class="app-layout">
    <header class="app-header-wrapper">
        <NavMenu />
    </header>

    <main id="main-content" class="app-main" tabindex="-1">
        <div class="app-container">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="error-boundary-card text-center p-4 p-md-5 my-4 mx-auto" role="alert">
                        <div class="error-boundary-icon-wrapper mb-3 mx-auto" aria-hidden="true">
                            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#C8453A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
                                <line x1="12" y1="9" x2="12" y2="13"></line>
                                <line x1="12" y1="17" x2="12.01" y2="17"></line>
                            </svg>
                        </div>
                        <h2 class="error-boundary-title mb-2">Algo salió mal</h2>
                        <p class="error-boundary-text mb-4">
                            Tuvimos un problema inesperado al cargar esta sección. Podés intentar de nuevo o volver al inicio para continuar navegando.
                        </p>
                        <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                            <button type="button" class="btn btn-primary px-4" @onclick="Reintentar">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2" aria-hidden="true">
                                    <polyline points="23 4 23 10 17 10"></polyline>
                                    <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                                </svg>
                                Intentar de nuevo
                            </button>
                            <button type="button" class="btn btn-outline-primary px-4" @onclick="VolverAlInicio">
                                Volver al inicio
                            </button>
                        </div>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </div>
    </main>

    <footer class="app-footer">
        <div class="app-container footer-inner">
            <div class="footer-brand">
                <div class="footer-logo">
                    <div class="footer-icon-wrapper" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 3a2 2 0 0 1 2 2c0 1.1-.9 2-2 2a2 2 0 0 1-2-2 2 2 0 0 1 2-2z" />
                            <path d="M12 7v2" />
                            <path d="M2.5 16.5 12 9l9.5 7.5a1.5 1.5 0 0 1-.9 2.5H3.4a1.5 1.5 0 0 1-.9-2.5z" />
                        </svg>
                    </div>
                    <span class="footer-title">Usaditos Hernando</span>
                </div>
                <p class="footer-tagline">Ropa infantil seleccionada con amor · Hernando, Córdoba</p>
            </div>
            <div class="footer-meta">
                <span>© @DateTime.Now.Year Usaditos Hernando. Moda circular para las infancias.</span>
            </div>
        </div>
    </footer>
</div>

@code {
    private ErrorBoundary? _errorBoundary;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    protected override void OnParametersSet()
    {
        _errorBoundary?.Recover();
    }

    private void Reintentar()
    {
        _errorBoundary?.Recover();
    }

    private void VolverAlInicio()
    {
        _errorBoundary?.Recover();
        Navigation.NavigateTo("/catalogo");
    }
}
