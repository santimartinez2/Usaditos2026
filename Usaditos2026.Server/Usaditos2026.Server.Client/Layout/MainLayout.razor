@inherits LayoutComponentBase

<div class="app-layout">
    <header class="app-header-wrapper">
        <NavMenu />
    </header>

    <main id="main-content" class="app-main" tabindex="-1">
        <div class="app-container">
            @Body
        </div>
    </main>

    <footer class="app-footer">
        <div class="app-container footer-inner">
            <div class="footer-brand">
                <div class="footer-logo">
                    <div class="footer-icon-wrapper" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 3a2 2 0 0 1 2 2c0 1.1-.9 2-2 2a2 2 0 0 1-2-2 2 2 0 0 1 2-2z" />
                            <path d="M12 7v2" />
                            <path d="M2.5 16.5 12 9l9.5 7.5a1.5 1.5 0 0 1-.9 2.5H3.4a1.5 1.5 0 0 1-.9-2.5z" />
                        </svg>
                    </div>
                    <span class="footer-title">Usaditos Hernando</span>
                </div>
                <p class="footer-tagline">Ropa infantil seleccionada con amor · Hernando, Córdoba</p>
            </div>
            <div class="footer-meta">
                <span>© @DateTime.Now.Year Usaditos Hernando. Moda circular para las infancias.</span>
            </div>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>
