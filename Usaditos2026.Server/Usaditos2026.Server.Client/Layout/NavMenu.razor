@using System.Security.Claims
@using Usaditos2026.Servicios.Interfaces
@using Usaditos2026.Shared.Constantes
@inject ICarritoServicio CarritoServicio
@inject NavigationManager Navigation

<!-- 1. Tira de notificación superior -->
<aside class="top-announcement" aria-label="Aviso de envíos y promociones">
    <div class="announcement-content">
        <span class="announcement-sparkle" aria-hidden="true">✨</span>
        <span>Envíos a todo el país desde Hernando, Córdoba · <strong>10% OFF</strong> en efectivo y transferencia</span>
    </div>
</aside>

<!-- 2. Barra de navegación principal -->
<nav class="app-nav" aria-label="Navegación principal">
    <div class="nav-container">
        <!-- Logotipo / Identidad de marca -->
        <a class="nav-brand" href="/" aria-label="Usaditos Hernando - Volver al inicio">
            <div class="brand-avatar" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3a2 2 0 0 1 2 2c0 1.1-.9 2-2 2a2 2 0 0 1-2-2 2 2 0 0 1 2-2z" />
                    <path d="M12 7v2" />
                    <path d="M2.5 16.5 12 9l9.5 7.5a1.5 1.5 0 0 1-.9 2.5H3.4a1.5 1.5 0 0 1-.9-2.5z" />
                </svg>
            </div>
            <div class="brand-text">
                <span class="brand-name">Usaditos Hernando</span>
                <span class="brand-sub">Ropa infantil con historia</span>
            </div>
        </a>

        <!-- Buscador centrado (Desktop) -->
        <div class="nav-search-desktop d-none d-md-block">
            <form class="search-form" @onsubmit="EjecutarBusqueda" role="search">
                <label for="desktop-search-input" class="visually-hidden">Buscar prendas en el catálogo</label>
                <div class="search-box">
                    <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input id="desktop-search-input"
                           type="search"
                           class="search-input"
                           placeholder="Buscar por nombre de prenda..."
                           @bind="_terminoBusqueda" />
                    <button type="submit" class="btn-search-submit">
                        Buscar
                    </button>
                </div>
            </form>
        </div>

        <!-- Acciones del encabezado: Cuenta y Carrito -->
        <div class="nav-actions">
            <AuthorizeView>
                <Authorized Context="auth">
                    <!-- Menú desplegable para usuario autenticado (details/summary puro para SSR e InteractiveServer) -->
                    <details class="user-menu-details">
                        <summary class="btn-user-toggle"
                                 aria-haspopup="true"
                                 aria-label="Menú de tu cuenta">
                            <div class="user-avatar-icon" aria-hidden="true">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                            </div>
                            <div class="user-label-wrap d-none d-sm-flex">
                                <span class="user-label-top">Hola</span>
                                <span class="user-label-name">@ObtenerPrimerNombre(auth.User.Identity?.Name)</span>
                            </div>
                            <svg class="chevron-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </summary>

                        <!-- Fondo invisible para cerrar al hacer clic afuera -->
                        <div class="menu-backdrop" onclick="this.closest('details').removeAttribute('open')" aria-hidden="true"></div>

                        <div class="user-dropdown-panel" role="menu">
                            <div class="dropdown-user-info">
                                <span class="user-full-name">@auth.User.Identity?.Name</span>
                                <span class="user-status-badge">Cliente activo</span>
                            </div>

                            <div class="dropdown-separator" role="separator"></div>

                            <a class="dropdown-item-link" href="/pedidos" role="menuitem">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                                    <line x1="3" y1="6" x2="21" y2="6"></line>
                                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                                </svg>
                                <span>Mis pedidos</span>
                            </a>

                            @if (_esAdmin)
                            {
                                <a class="dropdown-item-link admin-highlight" href="/admin/pedidos" role="menuitem">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <rect x="3" y="3" width="7" height="7"></rect>
                                        <rect x="14" y="3" width="7" height="7"></rect>
                                        <rect x="14" y="14" width="7" height="7"></rect>
                                        <rect x="3" y="14" width="7" height="7"></rect>
                                    </svg>
                                    <span>Administración</span>
                                </a>
                            }

                            <div class="dropdown-separator" role="separator"></div>

                            <form method="post" action="/api/auth/logout" class="logout-form">
                                <AntiforgeryToken />
                                <button type="submit" class="dropdown-item-link text-danger-btn" role="menuitem">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                        <polyline points="16 17 21 12 16 7"></polyline>
                                        <line x1="21" y1="12" x2="9" y2="12"></line>
                                    </svg>
                                    <span>Cerrar sesión</span>
                                </button>
                            </form>
                        </div>
                    </details>
                </Authorized>
                <NotAuthorized>
                    <!-- Botón para visitantes no autenticados -->
                    <a class="btn-guest-login" href="/login" aria-label="Iniciar sesión en tu cuenta">
                        <svg class="login-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        <div class="guest-text-wrap d-none d-sm-flex">
                            <span class="guest-top">Mi cuenta</span>
                            <span class="guest-action">Iniciar sesión</span>
                        </div>
                    </a>
                </NotAuthorized>
            </AuthorizeView>

            <!-- Botón del Carrito con contador -->
            <a class="nav-cart-btn" href="/carrito" aria-label="Ver carrito de compras, @(CantidadCarrito > 0 ? $"{CantidadCarrito} productos" : "vacío")">
                <div class="cart-icon-wrapper">
                    <svg class="cart-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <path d="M16 10a4 4 0 0 1-8 0"></path>
                    </svg>
                    @if (CantidadCarrito > 0)
                    {
                        <span class="cart-badge" aria-hidden="true">@CantidadCarrito</span>
                    }
                </div>
                <div class="cart-label-wrap d-none d-sm-flex">
                    <span class="cart-title">Carrito</span>
                    <span class="cart-status">@(CantidadCarrito > 0 ? $"{CantidadCarrito} unid." : "Vacío")</span>
                </div>
            </a>
        </div>
    </div>

    <!-- Buscador para pantallas móviles (< 768px) -->
    <div class="nav-search-mobile d-md-none">
        <form class="search-form" @onsubmit="EjecutarBusqueda" role="search">
            <label for="mobile-search-input" class="visually-hidden">Buscar prendas en el catálogo</label>
            <div class="search-box">
                <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input id="mobile-search-input"
                       type="search"
                       class="search-input"
                       placeholder="Buscar por prenda, talle..."
                       @bind="_terminoBusqueda" />
                <button type="submit" class="btn-search-submit">
                    Buscar
                </button>
            </div>
        </form>
    </div>
</nav>

@code {
    private int CantidadCarrito;
    private string? _terminoBusqueda;
    private bool _esAdmin;
    private int? _clienteId;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await ActualizarEstadoAsync();
    }

    private async Task ActualizarEstadoAsync()
    {
        if (AuthenticationStateTask is null)
        {
            CantidadCarrito = 0;
            _esAdmin = false;
            return;
        }

        var authenticationState = await AuthenticationStateTask;
        var usuario = authenticationState.User;

        if (usuario.Identity?.IsAuthenticated != true)
        {
            CantidadCarrito = 0;
            _esAdmin = false;
            _clienteId = null;
            return;
        }

        _esAdmin = usuario.IsInRole(RolConstantes.Admin);

        var idClaim = usuario.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(idClaim, out var clienteId))
        {
            _clienteId = clienteId;
            try
            {
                CantidadCarrito = await CarritoServicio.ObtenerCantidadItemsAsync(clienteId);
            }
            catch
            {
                CantidadCarrito = 0;
            }
        }
        else
        {
            CantidadCarrito = 0;
            _clienteId = null;
        }
    }

    private void EjecutarBusqueda()
    {
        if (!string.IsNullOrWhiteSpace(_terminoBusqueda))
        {
            Navigation.NavigateTo($"/catalogo?texto={Uri.EscapeDataString(_terminoBusqueda.Trim())}");
        }
        else
        {
            Navigation.NavigateTo("/catalogo");
        }
    }

    private static string ObtenerPrimerNombre(string? nombreCompleto)
    {
        if (string.IsNullOrWhiteSpace(nombreCompleto))
        {
            return "Tu cuenta";
        }

        var partes = nombreCompleto.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes.Length > 0 ? partes[0] : "Tu cuenta";
    }
}
