@inherits LayoutComponentBase
@using Usaditos2026.Shared.Constantes

<div class="admin-layout">
    <!-- 1. Encabezado superior para pantallas móviles (< 992px) -->
    <header class="admin-mobile-topbar d-lg-none" aria-label="Barra superior de administración">
        <button type="button"
                class="btn-hamburger"
                aria-label="@(_sidebarAbierto ? "Cerrar menú lateral" : "Abrir menú lateral")"
                aria-expanded="@_sidebarAbierto"
                @onclick="ToggleSidebar">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                @if (_sidebarAbierto)
                {
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                }
                else
                {
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                }
            </svg>
        </button>

        <a class="mobile-brand" href="/admin/pedidos">
            <div class="mobile-brand-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3a2 2 0 0 1 2 2c0 1.1-.9 2-2 2a2 2 0 0 1-2-2 2 2 0 0 1 2-2z" />
                    <path d="M12 7v2" />
                    <path d="M2.5 16.5 12 9l9.5 7.5a1.5 1.5 0 0 1-.9 2.5H3.4a1.5 1.5 0 0 1-.9-2.5z" />
                </svg>
            </div>
            <div class="mobile-brand-text">
                <span class="mobile-brand-name">Usaditos</span>
                <span class="mobile-brand-tag">Administración</span>
            </div>
        </a>

        <div class="mobile-badge-staff">
            <span class="badge-dot" aria-hidden="true"></span>
            <span>Admin</span>
        </div>
    </header>

    <!-- Fondo oscuro al abrir el sidebar en pantallas móviles -->
    <div class="admin-sidebar-backdrop @(_sidebarAbierto ? "show" : "")"
         @onclick="CerrarSidebar"
         aria-hidden="true"></div>

    <!-- 2. Barra lateral (Sidebar) en verde muy oscuro (#14342B) -->
    <aside class="admin-sidebar @(_sidebarAbierto ? "open" : "")" aria-label="Menú de administración">
        <div class="sidebar-top">
            <div class="sidebar-brand-header">
                <div class="brand-avatar" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3a2 2 0 0 1 2 2c0 1.1-.9 2-2 2a2 2 0 0 1-2-2 2 2 0 0 1 2-2z" />
                        <path d="M12 7v2" />
                        <path d="M2.5 16.5 12 9l9.5 7.5a1.5 1.5 0 0 1-.9 2.5H3.4a1.5 1.5 0 0 1-.9-2.5z" />
                    </svg>
                </div>
                <div class="brand-info">
                    <span class="brand-title">Usaditos</span>
                    <span class="brand-badge">Administración</span>
                </div>
                <button type="button"
                        class="btn-close-sidebar d-lg-none"
                        aria-label="Cerrar menú"
                        @onclick="CerrarSidebar">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <!-- Navegación principal del panel de administración -->
            <nav class="sidebar-nav" aria-label="Enlaces de administración">
                <NavLink class="sidebar-nav-item" href="/admin/pedidos" @onclick="CerrarSidebar">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="21 8 21 21 3 21 3 8"></polyline>
                        <rect x="1" y="3" width="22" height="5"></rect>
                        <line x1="10" y1="12" x2="14" y2="12"></line>
                    </svg>
                    <span>Pedidos</span>
                </NavLink>

                <NavLink class="sidebar-nav-item" href="/admin/productos" @onclick="CerrarSidebar">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"></path>
                    </svg>
                    <span>Productos</span>
                </NavLink>

                <NavLink class="sidebar-nav-item" href="/admin/categorias" @onclick="CerrarSidebar">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                    <span>Categorías</span>
                </NavLink>

                <div class="sidebar-divider" role="separator" aria-hidden="true"></div>

                <a class="sidebar-nav-item item-store" href="/catalogo" @onclick="CerrarSidebar">
                    <div class="d-flex align-items-center gap-2">
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                        <span>Ver tienda</span>
                    </div>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="external-icon">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                </a>
            </nav>
        </div>

        <!-- Pie del sidebar: Cerrar sesión -->
        <div class="sidebar-footer">
            <form method="post" action="/api/auth/logout" class="admin-logout-form">
                <AntiforgeryToken />
                <button type="submit" class="btn-sidebar-logout" aria-label="Cerrar sesión de administrador">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    <span>Cerrar sesión</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- 3. Contenedor principal de contenidos -->
    <div class="admin-main-wrap">
        <header class="admin-top-header d-none d-lg-flex" aria-label="Barra superior de escritorio">
            <div class="header-breadcrumbs">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                </svg>
                <span>/</span>
                <span class="active-crumb">Panel de Administración</span>
            </div>

            <div class="header-staff-pill">
                <div class="staff-text">
                    <span class="staff-title">Hernando Staff</span>
                    <span class="staff-role">Administrador</span>
                </div>
                <div class="staff-avatar" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </div>
            </div>
        </header>

        <main id="admin-content" class="admin-body-content" tabindex="-1">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _sidebarAbierto;

    private void ToggleSidebar()
    {
        _sidebarAbierto = !_sidebarAbierto;
    }

    private void CerrarSidebar()
    {
        _sidebarAbierto = false;
    }
}
